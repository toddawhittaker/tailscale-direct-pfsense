#!/bin/sh
#
# tailscale_watchdogd
#
# Foreground daemon that checks selected Tailscale peers once per interval.
# If a peer is relayed for FAIL_THRESHOLD consecutive checks, restart the
# services in RESTART_SERVICES (pfsense_tailscaled by default), then send an
# optional notification.
#
# Documentation:
#   https://github.com/toddawhittaker/tailscale-direct-pfsense
#
# Normal healthy operation performs no per-minute disk writes.
#
# Usage:
#   tailscale_watchdogd [-t] [-1] [-d] [-f config_file] [-i seconds] [-n threshold] [-c ping_count]
#
# Options:
#   -t    Test mode: never restart services.
#   -1    One-shot mode: run one check cycle and exit.
#   -d    Debug mode: print classifications and tailscale ping output to stderr.
#   -f    Config file path. Default: /usr/local/etc/tailscale_watchdog.conf.
#   -i    Check interval in seconds. Overrides config/default.
#   -n    Consecutive relayed checks required before restart. Overrides config/default.
#   -c    tailscale ping count. Overrides config/default.
#
# Security notes:
#   - The config file must be owned by root and not readable, writable, or
#     executable by group or world (mode 0600 recommended).  Permissions are
#     verified with stat(1) before sourcing.
#   - Notification credentials are passed to curl through a config stream on
#     stdin, not as process arguments.
#   - Peer names are validated to contain only hostname-safe characters before
#     being passed to tailscale ping, and checked for post-sanitization
#     collisions that would cause two peers to share the same state counter.
#
PATH="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"
TAG="tailscale_watchdog"
DOCS_URL="https://github.com/toddawhittaker/tailscale-direct-pfsense"

# ---- Configuration defaults ------------------------------------------------
#
# These defaults may be overridden by the config file.
# Command-line flags override both defaults and config-file values.
CONFIG_FILE="/usr/local/etc/tailscale_watchdog.conf"
PUSHOVER_TOKEN=""
PUSHOVER_USER=""
NOTIFY_PROVIDER="pushover"
NOTIFY_ON_STARTUP=1
LOCAL_TAILSCALE_NAME=""
PEERS="router1 router2"
CHECK_INTERVAL=60
FAIL_THRESHOLD=5
PING_COUNT=5
# Minimum and maximum seconds after a restart attempt before another restart
# is allowed.  After each restart attempt a random value in this range is
# chosen as the cooldown for that router.  Using a range rather than a fixed
# value prevents multiple routers that monitor one another from settling into
# synchronized restart cycles: each picks its own next-allowed time
# independently, so they naturally spread apart even if they restart together.
#
# Example with three routers and RESTART_COOLDOWN_MIN=900 / MAX=2700:
#   router1 restarts -> next restart allowed in 1248 seconds
#   router2 restarts -> next restart allowed in 2341 seconds
#   router3 restarts -> next restart allowed in 987 seconds
#
# Set MIN and MAX to the same value to get a fixed cooldown.
RESTART_COOLDOWN_MIN=900
RESTART_COOLDOWN_MAX=2700
# Only pfsense_tailscaled.  Its rc.d stop and start already cycle tailscaled
# underneath (via run_rc_script against the upstream rc file), so listing
# tailscaled as well bounces the daemon twice.  The pfSense GUI's service
# control restarts pfsense_tailscaled alone and never touches tailscaled; the
# extra bounce is redundant and adds churn that the post-start hook has to
# race against.  See docs/daemon-behavior.md.
RESTART_SERVICES="pfsense_tailscaled"
# Seconds to wait between stopping and starting each service.  See
# restart_tailscale_services for why the stop and start are separate.  Set to 0
# to stop and start back to back.  Capped; see validate_config.
RESTART_SETTLE_SECONDS=3
RESTART_DEFERRAL_ENABLED=1
RESTART_DEFERRAL_INTERFACE="tailscale0"
RESTART_DEFERRAL_CHECK_SECONDS=30
RESTART_DEFERRAL_MAX_BYTES=65536
RESTART_DEFERRAL_MAX_ATTEMPTS=10
CURL_TIMEOUT=10

# ---- Runtime state ---------------------------------------------------------

# reset_runtime_state
#
# Assigns every value that is internal state rather than an operator setting.
# Called once here, and again from main immediately after load_config_file.
#
# The second call is the point.  The live config is sourced into this same
# namespace, so without it any assignment in the config silently becomes
# runtime state.  That is not hypothetical harm:
#
#   SLEEP_PID       handle_shutdown does `kill "$SLEEP_PID"` as root with no
#                   validation.  SLEEP_PID=1 in a config turns the first
#                   `service tailscale_watchdog stop` into a SIGTERM to init.
#   RESTART_CRITICAL  handle_shutdown would defer every signal for the life of
#                   the daemon, leaving SIGKILL as the only way to stop it.
#   TEST            the daemon logs "would restart" forever and never restarts
#                   anything -- a watchdog that has silently stopped watching.
#   DEBUG           per-check output to a stderr the rc wrapper has already
#                   unlinked, consuming a RAM-backed /tmp invisibly.
#
# This is deliberately one function covering the whole block rather than an
# enumerated subset re-asserted in main.  An earlier version listed four names
# there and missed SLEEP_PID, which is the one that reaches a kill.
#
# Nothing enforces that a new internal is added here rather than left at top
# level; static checks for it were tried and were all bypassable.  Treat the
# rule in AGENTS.md as the control, and put new internal state in this function.
# Values that are genuinely operator settings belong in the defaults block
# above and in tailscale_watchdog.conf.example.
#
# CLI options are parsed after main's call, so -t, -1, and -d still win.
reset_runtime_state() {
  TEST=0
  ONE_SHOT=0
  DEBUG=0
  RESTART_DEFERRAL_ATTEMPTS=0
  LAST_RESTART_COOLDOWN=""
  LAST_RESTART_NEXT_ALLOWED=""
  LAST_RESTART_DEFERRAL_RESULT=""
  LAST_RESTART_DEFERRAL_DELTA=""
  LAST_RESTART_DEFERRAL_ATTEMPTS=""
  RESOLVED_LOCAL_TAILSCALE_NAME=""

  # Holds the PID of the background sleep process during the main loop so that
  # handle_shutdown can kill it promptly on SIGTERM/SIGINT.
  SLEEP_PID=""

  # Set to 1 while restart_tailscale_services is between a service stop and the
  # matching start.  Exiting there would leave Tailscale stopped, so
  # handle_shutdown records the request in SHUTDOWN_PENDING and returns instead;
  # the restart path exits once the start has run.
  RESTART_CRITICAL=0
  SHUTDOWN_PENDING=0

  # Derived from the rc wrapper's SIGKILL escalation window, not chosen.
  RESTART_SETTLE_SECONDS_MAX=4

  # Where a root daemon creates files; see run_service_command.
  SERVICE_OUTPUT_TEMPLATE="/tmp/tailscale_watchdog.service.XXXXXX"

  # Runtime state paths.  Fixed, not settings: AGENTS.md pins the state
  # directory and the cooldown file, and uninstall.sh hardcodes the same
  # directory to remove them, so a relocated state directory would survive
  # uninstall.  Relocating state also decides whether cooldown survives a
  # reboot, which is a behavior choice rather than something to fall out of a
  # stray config line.
  #
  # Derived together on purpose.  These used to sit in the defaults block with
  # NEXT_RESTART_FILE expanded once from STATE_DIR, so a config assigning only
  # STATE_DIR moved the directory and not the file.  mark_restart_attempt then
  # created and mktemp'd under the new directory and mv'd into the old one,
  # which no longer existed; the write failed, and restart_tailscale_services
  # returned before touching any service.  The watchdog stopped restarting
  # anything, silently, for the life of the install.
  STATE_DIR="/var/run/tailscale_watchdog"

  # Stores the epoch at which the next restart attempt is allowed.  Written
  # after every restart attempt, success or failure, with a randomly chosen
  # value between now+MIN and now+MAX.  Storing the next-allowed time rather
  # than the last-attempt time means cooldown_remaining does not need to
  # recompute elapsed time or remember which random cooldown was chosen.
  NEXT_RESTART_FILE="${STATE_DIR}/next_restart_allowed"
}
reset_runtime_state

# ---- Utility functions -----------------------------------------------------

# usage
#
# Prints command-line usage to stderr.  This function does not exit so callers
# can choose the correct exit status for parse errors or help output.
usage() {
  cat >&2 <<EOF
Usage: $0 [-t] [-1] [-d] [-f config_file] [-i seconds] [-n threshold] [-c ping_count]
Options:
  -t    Test mode: never restart services.
  -1    One-shot mode: run one check cycle and exit.
  -d    Debug mode: print classifications and tailscale ping output to stderr.
  -f    Config file path. Default: ${CONFIG_FILE}.
  -i    Check interval in seconds. Default: ${CHECK_INTERVAL}.
  -n    Consecutive relayed checks required before restart. Default: ${FAIL_THRESHOLD}.
  -c    tailscale ping count. Default: ${PING_COUNT}.
EOF
}

# is_positive_int VALUE
#
# Returns 0 for a non-empty decimal integer greater than zero.  Used for
# config and CLI validation before values reach arithmetic contexts.
is_positive_int() {
  case "$1" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac
  [ "$1" -gt 0 ] 2>/dev/null
}

# is_nonnegative_int VALUE
#
# Like is_positive_int but also accepts 0, for settings where zero means
# "skip this step" rather than an invalid value.
is_nonnegative_int() {
  case "$1" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac
  [ "$1" -ge 0 ] 2>/dev/null
}

# is_bool VALUE
#
# Returns 0 only for the config booleans accepted by this script: 0 or 1.
is_bool() {
  case "$1" in
    0|1)
      return 0
      ;;
  esac
  return 1
}

# is_hostname_safe VALUE
#
# Returns 0 for names that are safe to put in logs, notifications, and simple
# shell command arguments after validation.
is_hostname_safe() {
  case "$1" in
    ''|-*|*[!A-Za-z0-9._-]*)
      return 1
      ;;
  esac
  return 0
}

# log_msg MESSAGE...
#
# Writes operational logs through logger(1), and mirrors them to stderr in
# debug mode.  This must never write to stdout because it is called from
# functions that may run inside command substitutions.
log_msg() {
  logger -t "$TAG" "$*"
  if [ "$DEBUG" -eq 1 ]; then
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2
  fi
}

# debug_msg MESSAGE...
#
# Writes debug-only diagnostics to stderr.  Keep stdout clean so callers can
# safely capture function return values such as path classifications.
debug_msg() {
  if [ "$DEBUG" -eq 1 ]; then
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2
  fi
}

# config_is_safe_to_source FILE
#
# Verifies that FILE is:
#   - a regular file
#   - readable by the current process
#   - owned by root
#   - has no group or world permissions set (mode 0600 or stricter)
#
# Uses stat(1) rather than parsing ls(1) output, which avoids fragile
# positional pattern matching on permission strings that vary across systems
# and can include ACL indicator characters.
#
# stat -f '%Su' returns the owning username.
# stat -f '%Lp' returns the numeric permission bits in octal as a 3- or
# 4-digit string (e.g. "600", "644", "755").  The leading-zero form
# $(( 0$octal & 077 )) causes the shell to interpret the value as octal
# without requiring the non-POSIX 8# base prefix.
config_is_safe_to_source() {
  file="$1"

  if [ ! -f "$file" ]; then
    echo "Config file is not a regular file: $file" >&2
    return 1
  fi

  if [ ! -r "$file" ]; then
    echo "Config file is not readable: $file" >&2
    return 1
  fi

  if ! command -v stat >/dev/null 2>&1; then
    echo "stat(1) not found; cannot verify config file permissions" >&2
    return 1
  fi

  owner="$(stat -f '%Su' "$file" 2>/dev/null)"
  if [ "$owner" != "root" ]; then
    echo "Config file must be owned by root: $file (current owner: ${owner:-unknown})" >&2
    echo "Run: chown root:wheel $file" >&2
    return 1
  fi

  octal="$(stat -f '%Lp' "$file" 2>/dev/null)"

  case "$octal" in
    [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7])
      ;;
    *)
      echo "Could not determine permissions for config file: $file (stat returned: '${octal}')" >&2
      return 1
      ;;
  esac

  if [ "$(( 0${octal} & 077 ))" -ne 0 ]; then
    echo "Config file must not have group or world permissions: $file (mode: ${octal})" >&2
    echo "Run: chmod 0600 $file" >&2
    return 1
  fi

  return 0
}

# load_config_file FILE
#
# Verifies and sources the live config, then restores the known-safe PATH so
# config content cannot alter command lookup for later privileged operations.
load_config_file() {
  file="$1"

  if [ ! -e "$file" ]; then
    echo "Config file not found: $file" >&2
    exit 2
  fi

  if ! config_is_safe_to_source "$file"; then
    exit 2
  fi

  . "$file"

  PATH="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"
  return 0
}

# validate_config
#
# Validates sourced config values after CLI overrides are applied.  This is
# the boundary that turns shell-sourced text into constrained peer names,
# service names, intervals, cooldowns, and deferral settings.
validate_config() {
  if [ -z "$PEERS" ]; then
    echo "PEERS must not be empty" >&2
    exit 2
  fi

  _seen_safe=""
  _noglob_was_set=0
  case $- in
    *f*) _noglob_was_set=1 ;;
    *) set -f ;;
  esac
  for _vpeer in $PEERS; do
    case "$_vpeer" in
      -*)
        echo "Invalid peer name (contains shell-unsafe characters): ${_vpeer}" >&2
        exit 2
        ;;
      *[!A-Za-z0-9._-]*)
        echo "Invalid peer name (contains shell-unsafe characters): ${_vpeer}" >&2
        exit 2
        ;;
    esac
    _vsafe="$(safe_peer_name "$_vpeer")"
    case " ${_seen_safe} " in
      *" ${_vsafe} "*)
        echo "Invalid peer list: '${_vpeer}' collides with another peer after sanitization as '${_vsafe}'" >&2
        exit 2
        ;;
    esac
    _seen_safe="${_seen_safe} ${_vsafe}"
  done
  if [ "$_noglob_was_set" -eq 0 ]; then
    set +f
  fi
  unset _vpeer _vsafe _seen_safe _noglob_was_set

  if ! is_positive_int "$CHECK_INTERVAL"; then
    echo "CHECK_INTERVAL must be a positive integer: $CHECK_INTERVAL" >&2
    exit 2
  fi
  if ! is_positive_int "$FAIL_THRESHOLD"; then
    echo "FAIL_THRESHOLD must be a positive integer: $FAIL_THRESHOLD" >&2
    exit 2
  fi
  if ! is_positive_int "$PING_COUNT"; then
    echo "PING_COUNT must be a positive integer: $PING_COUNT" >&2
    exit 2
  fi
  if ! is_positive_int "$RESTART_COOLDOWN_MIN"; then
    echo "RESTART_COOLDOWN_MIN must be a positive integer: $RESTART_COOLDOWN_MIN" >&2
    exit 2
  fi
  if ! is_positive_int "$RESTART_COOLDOWN_MAX"; then
    echo "RESTART_COOLDOWN_MAX must be a positive integer: $RESTART_COOLDOWN_MAX" >&2
    exit 2
  fi
  if [ "$RESTART_COOLDOWN_MAX" -lt "$RESTART_COOLDOWN_MIN" ]; then
    echo "RESTART_COOLDOWN_MAX (${RESTART_COOLDOWN_MAX}) must be >= RESTART_COOLDOWN_MIN (${RESTART_COOLDOWN_MIN})" >&2
    exit 2
  fi
  if ! is_positive_int "$CURL_TIMEOUT"; then
    echo "CURL_TIMEOUT must be a positive integer: $CURL_TIMEOUT" >&2
    exit 2
  fi
  case "$NOTIFY_PROVIDER" in
    ''|none|pushover)
      ;;
    -*|*[!A-Za-z0-9._-]*)
      echo "Invalid notification provider (contains shell-unsafe characters): ${NOTIFY_PROVIDER}" >&2
      exit 2
      ;;
    *)
      echo "Unsupported notification provider: ${NOTIFY_PROVIDER}" >&2
      exit 2
      ;;
  esac
  if ! is_bool "$NOTIFY_ON_STARTUP"; then
    echo "NOTIFY_ON_STARTUP must be 0 or 1: $NOTIFY_ON_STARTUP" >&2
    exit 2
  fi
  if [ -n "$LOCAL_TAILSCALE_NAME" ] && ! is_hostname_safe "$LOCAL_TAILSCALE_NAME"; then
    echo "Invalid local Tailscale name (contains shell-unsafe characters): ${LOCAL_TAILSCALE_NAME}" >&2
    exit 2
  fi
  if ! is_bool "$RESTART_DEFERRAL_ENABLED"; then
    echo "RESTART_DEFERRAL_ENABLED must be 0 or 1: $RESTART_DEFERRAL_ENABLED" >&2
    exit 2
  fi
  if [ -z "$RESTART_DEFERRAL_INTERFACE" ]; then
    echo "RESTART_DEFERRAL_INTERFACE must not be empty" >&2
    exit 2
  fi
  case "$RESTART_DEFERRAL_INTERFACE" in
    -*|*[!A-Za-z0-9._-]*)
      echo "Invalid restart deferral interface (contains shell-unsafe characters): ${RESTART_DEFERRAL_INTERFACE}" >&2
      exit 2
      ;;
  esac
  if ! is_positive_int "$RESTART_DEFERRAL_CHECK_SECONDS"; then
    echo "RESTART_DEFERRAL_CHECK_SECONDS must be a positive integer: $RESTART_DEFERRAL_CHECK_SECONDS" >&2
    exit 2
  fi
  if ! is_positive_int "$RESTART_DEFERRAL_MAX_BYTES"; then
    echo "RESTART_DEFERRAL_MAX_BYTES must be a positive integer: $RESTART_DEFERRAL_MAX_BYTES" >&2
    exit 2
  fi
  if ! is_positive_int "$RESTART_DEFERRAL_MAX_ATTEMPTS"; then
    echo "RESTART_DEFERRAL_MAX_ATTEMPTS must be a positive integer: $RESTART_DEFERRAL_MAX_ATTEMPTS" >&2
    exit 2
  fi
  if [ -z "$RESTART_SERVICES" ]; then
    echo "RESTART_SERVICES must not be empty" >&2
    exit 2
  fi
  if ! is_nonnegative_int "$RESTART_SETTLE_SECONDS"; then
    echo "RESTART_SETTLE_SECONDS must be a non-negative integer: $RESTART_SETTLE_SECONDS" >&2
    exit 2
  fi
  # Bounded by the rc wrapper's shutdown budget, not by taste.
  # tailscale_watchdog_stop sends TERM and escalates to SIGKILL after 10
  # seconds.  (The 5-second escalation in kill_and_wait is a different path --
  # it only cleans up a just-started daemon whose pidfile write failed, which
  # cannot be mid-restart.)  A shutdown arriving during a restart is deferred
  # until the starts have run, but SIGKILL cannot be deferred: if it lands
  # while a settle is still sleeping, a service has been stopped and never
  # started, which is the state this whole sequence exists to avoid.
  #
  # A settle already sleeping when the signal arrives runs to completion, since
  # the trap cannot run until the sleep returns.  Settles not yet started are
  # skipped once a shutdown is pending -- see restart_tailscale_services -- so
  # at most one full settle sits on the deadline path however many services are
  # configured.  The cap keeps that single pause well inside the 10-second
  # window with room for the stops and starts themselves.
  #
  # The bound is not an operator setting.  main re-asserts it after the live
  # config is sourced, so a config that assigns RESTART_SETTLE_SECONDS_MAX
  # cannot raise the cap or, by giving it a non-numeric value, make the
  # comparison below error out and silently skip the check.
  if [ "$RESTART_SETTLE_SECONDS" -gt "$RESTART_SETTLE_SECONDS_MAX" ]; then
    echo "RESTART_SETTLE_SECONDS must be <= ${RESTART_SETTLE_SECONDS_MAX} (the rc wrapper escalates to SIGKILL 10s after TERM): $RESTART_SETTLE_SECONDS" >&2
    exit 2
  fi
  _noglob_was_set=0
  case $- in
    *f*) _noglob_was_set=1 ;;
    *) set -f ;;
  esac
  for _vsvc in $RESTART_SERVICES; do
    case "$_vsvc" in
      -*)
        echo "Invalid service name (contains shell-unsafe characters): ${_vsvc}" >&2
        exit 2
        ;;
      *[!A-Za-z0-9._-]*)
        echo "Invalid service name (contains shell-unsafe characters): ${_vsvc}" >&2
        exit 2
        ;;
    esac
  done
  if [ "$_noglob_was_set" -eq 0 ]; then
    set +f
  fi
  unset _vsvc _noglob_was_set
}

# curl_config_escape VALUE
#
# Escapes backslashes and double quotes for values written to curl's -K
# config stream.  This keeps notification secrets out of process arguments.
curl_config_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# write_pushover_curl_config
#
# Writes the secret-bearing curl config used for Pushover requests.
write_pushover_curl_config() {
  printf 'fail\n'
  printf 'show-error\n'
  printf 'silent\n'
  printf 'max-time = "%s"\n' "$(curl_config_escape "$CURL_TIMEOUT")"
  printf 'url = "https://api.pushover.net/1/messages.json"\n'
  printf 'form-string = "token=%s"\n' "$(curl_config_escape "$PUSHOVER_TOKEN")"
  printf 'form-string = "user=%s"\n' "$(curl_config_escape "$PUSHOVER_USER")"
}

# notifications_may_send
#
# Returns 0 when the configured provider has enough local configuration to
# attempt delivery.  This avoids doing notification-only work, such as local
# name detection, when notifications are disabled or credentials are blank.
notifications_may_send() {
  case "$NOTIFY_PROVIDER" in
    ''|none)
      return 1
      ;;
    pushover)
      [ -n "$PUSHOVER_TOKEN" ] && [ -n "$PUSHOVER_USER" ]
      return $?
      ;;
  esac
  return 0
}

# notify [TITLE] MESSAGE
#
# Dispatches an optional notification through the configured provider.  A blank
# provider or "none" is a clean no-op.  Provider failures are logged but do not
# alter restart state.
notify() {
  title="${1:-}"
  message="${2:-}"

  if [ -z "$message" ]; then
    message="$title"
    title=""
  fi

  case "$NOTIFY_PROVIDER" in
    ''|none)
      log_msg "Notification skipped: provider is disabled"
      return 0
      ;;
    pushover)
      notify_pushover "$title" "$message"
      return $?
      ;;
    *)
      log_msg "Notification failed: unsupported provider '${NOTIFY_PROVIDER}'"
      return 1
      ;;
  esac
}

# notify_pushover TITLE MESSAGE
#
# Sends a Pushover notification using curl's config stream.  Missing Pushover
# credentials are treated as disabled notifications for backward compatibility.
notify_pushover() {
  title="$1"
  message="$2"

  if [ -z "$PUSHOVER_TOKEN" ] || [ -z "$PUSHOVER_USER" ]; then
    log_msg "Pushover notification skipped: token or user key is empty"
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    log_msg "Pushover notification failed: curl not found"
    return 1
  fi

  if [ -n "$title" ]; then
    if ! write_pushover_curl_config | curl -K - \
      --data-urlencode "title=${title}" \
      --data-urlencode "message=${message}" \
      >/dev/null 2>&1; then
      log_msg "Pushover notification failed"
      return 1
    fi
  elif ! write_pushover_curl_config | curl -K - \
    --data-urlencode "message=${message}" \
    >/dev/null 2>&1; then
    log_msg "Pushover notification failed"
    return 1
  fi

  return 0
}

# detect_local_tailscale_name
#
# Prints the local Tailscale hostname as shown by tailscale status.  This is a
# best-effort notification label only; failure must not affect daemon behavior.
detect_local_tailscale_name() {
  if ! command -v tailscale >/dev/null 2>&1; then
    log_msg "Local Tailscale name detection failed: tailscale not found"
    printf 'unknown\n'
    return 1
  fi

  output="$(tailscale status --self --peers=false 2>/dev/null)"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    log_msg "Local Tailscale name detection failed: tailscale status rc=${rc}"
    printf 'unknown\n'
    return 1
  fi

  name="$(printf '%s\n' "$output" | awk 'NF && $1 !~ /^#/ { print $2; exit }')"
  if ! is_hostname_safe "$name"; then
    log_msg "Local Tailscale name detection failed: unexpected status output"
    printf 'unknown\n'
    return 1
  fi

  printf '%s\n' "$name"
  return 0
}

# local_tailscale_name
#
# Prints the configured or detected local Tailscale name.  The value is cached
# after first resolution so repeated notifications do not run tailscale status.
local_tailscale_name() {
  if [ -n "$RESOLVED_LOCAL_TAILSCALE_NAME" ]; then
    printf '%s\n' "$RESOLVED_LOCAL_TAILSCALE_NAME"
    return 0
  fi

  if [ -n "$LOCAL_TAILSCALE_NAME" ]; then
    RESOLVED_LOCAL_TAILSCALE_NAME="$LOCAL_TAILSCALE_NAME"
    printf '%s\n' "$RESOLVED_LOCAL_TAILSCALE_NAME"
    return 0
  fi

  RESOLVED_LOCAL_TAILSCALE_NAME="$(detect_local_tailscale_name)"
  printf '%s\n' "$RESOLVED_LOCAL_TAILSCALE_NAME"
}

# startup_notification_title ROUTER_NAME
startup_notification_title() {
  printf 'Tailscale watchdog: %s started' "$1"
}

# startup_notification_message
#
# Prints the human-readable daemon startup notification body.  Keep this
# secret-free: peer names and service names are allowed, but provider
# credentials, webhook URLs, and config file paths are not.
startup_notification_message() {
  router_name="$1"

  printf 'Router: %s\n' "$router_name"
  printf 'Event: started\n'
  printf 'Peers: %s\n' "$PEERS"
  printf 'Check interval: %ss\n' "$CHECK_INTERVAL"
  printf 'Relay threshold: %s consecutive checks\n' "$FAIL_THRESHOLD"
  printf 'Ping count: %s\n' "$PING_COUNT"
  printf 'Restart cooldown: %s-%ss\n' "$RESTART_COOLDOWN_MIN" "$RESTART_COOLDOWN_MAX"
  printf 'Restart services: %s\n' "$RESTART_SERVICES"
  if [ "$RESTART_DEFERRAL_ENABLED" -eq 1 ]; then
    printf 'Restart deferral: enabled on %s (%ss sample, max %s bytes, max %s attempts)\n' \
      "$RESTART_DEFERRAL_INTERFACE" \
      "$RESTART_DEFERRAL_CHECK_SECONDS" \
      "$RESTART_DEFERRAL_MAX_BYTES" \
      "$RESTART_DEFERRAL_MAX_ATTEMPTS"
  else
    printf 'Restart deferral: disabled\n'
  fi
  printf 'Docs: %s' "$DOCS_URL"
}

# restart_notification_title ROUTER_NAME RESULT
restart_notification_title() {
  router_name="$1"
  result="$2"

  case "$result" in
    success)
      printf 'Tailscale watchdog: %s restarted' "$router_name"
      ;;
    failure)
      printf 'Tailscale watchdog: %s restart failed' "$router_name"
      ;;
  esac
}

# restart_notification_message ROUTER_NAME RESULT PEER COUNT
restart_notification_message() {
  router_name="$1"
  result="$2"
  reason_peer="$3"
  reason_count="$4"

  printf 'Router: %s\n' "$router_name"
  case "$result" in
    success)
      printf 'Event: restart completed\n'
      ;;
    failure)
      printf 'Event: restart failed\n'
      ;;
  esac
  printf 'Trigger peer: %s\n' "$reason_peer"
  printf 'Relay count: %s consecutive checks\n' "$reason_count"
  printf 'Services: %s' "$RESTART_SERVICES"
}

# notify_startup_if_enabled
#
# Sends the optional daemon startup notification after final config validation
# and startup logging.  It is skipped for test and one-shot runs, and any
# provider failure is logged but never prevents the daemon from starting.
notify_startup_if_enabled() {
  if [ "$NOTIFY_ON_STARTUP" -ne 1 ]; then
    return 0
  fi
  if [ "$TEST" -eq 1 ] || [ "$ONE_SHOT" -eq 1 ]; then
    return 0
  fi
  if ! notifications_may_send; then
    notify "Startup notification skipped"
    return 0
  fi

  router_name="$(local_tailscale_name)"
  if ! notify "$(startup_notification_title "$router_name")" "$(startup_notification_message "$router_name")"; then
    log_msg "Startup notification failed"
  fi
  return 0
}

# ---- Per-peer variable helpers ---------------------------------------------

# safe_peer_name PEER
#
# Converts a validated peer name into a shell-variable-safe suffix.  The
# validator rejects collisions before this helper is used for state storage.
safe_peer_name() {
  printf '%s' "$1" | sed 's/[^A-Za-z0-9_]/_/g'
}

# peer_var ATTR PEER
#
# Builds the dynamic shell variable name used for one per-peer attribute.
peer_var() {
  attr="$1"
  peer="$2"
  safe="$(safe_peer_name "$peer")"
  printf 'tsw_%s_%s' "$attr" "$safe"
}

# get_peer_attr ATTR PEER DEFAULT
#
# Reads a dynamic per-peer variable, returning DEFAULT when unset or empty.
# Peer names are validated before use so the eval target is controlled.
get_peer_attr() {
  attr="$1"
  peer="$2"
  default="$3"
  var="$(peer_var "$attr" "$peer")"
  eval "_gpa_tmp=\"\${${var}:-}\""
  if [ -z "$_gpa_tmp" ]; then
    printf '%s\n' "$default"
  else
    printf '%s\n' "$_gpa_tmp"
  fi
}

# set_peer_attr ATTR PEER VALUE
#
# Writes a dynamic per-peer variable.  Keep all callers behind config
# validation so ATTR/PEER cannot become arbitrary shell code.
set_peer_attr() {
  attr="$1"
  peer="$2"
  value="$3"
  var="$(peer_var "$attr" "$peer")"
  eval "${var}=\$value"
}

# reset_all_peer_state_after_restart
#
# Resets every peer after a successful restart and clears global deferral
# state.  Restart impact is global, so all peer counters are reset together.
reset_all_peer_state_after_restart() {
  _noglob_was_set=0
  case $- in
    *f*) _noglob_was_set=1 ;;
    *) set -f ;;
  esac
  for peer in $PEERS; do
    set_peer_attr count "$peer" 0
    set_peer_attr state "$peer" post_restart
    set_peer_attr threshold_seen "$peer" none
  done
  if [ "$_noglob_was_set" -eq 0 ]; then
    set +f
  fi
  RESTART_DEFERRAL_ATTEMPTS=0
  unset _noglob_was_set
}

# reset_restart_deferral_if_no_threshold
#
# Clears global deferral attempts when no peer remains at or above the relay
# threshold.  This prevents stale busy-traffic deferrals from affecting a
# later, unrelated relay episode.
reset_restart_deferral_if_no_threshold() {
  _noglob_was_set=0
  case $- in
    *f*) _noglob_was_set=1 ;;
    *) set -f ;;
  esac
  for peer in $PEERS; do
    count="$(get_peer_attr count "$peer" 0)"
    if [ "$count" -ge "$FAIL_THRESHOLD" ]; then
      if [ "$_noglob_was_set" -eq 0 ]; then
        set +f
      fi
      unset _noglob_was_set
      return 0
    fi
  done
  if [ "$_noglob_was_set" -eq 0 ]; then
    set +f
  fi
  unset _noglob_was_set

  if [ "$RESTART_DEFERRAL_ATTEMPTS" -gt 0 ]; then
    log_msg "Restart deferral state reset: no peer remains at the relay threshold"
  fi
  RESTART_DEFERRAL_ATTEMPTS=0
}

# ---- Restart cooldown state ------------------------------------------------

# random_cooldown_seconds
#
# Returns a random integer in [RESTART_COOLDOWN_MIN, RESTART_COOLDOWN_MAX].
# Uses jot(1), which is available on FreeBSD/pfSense.
#
# -w '%d' forces integer output, preventing jot from returning a
# floating-point value on some inputs.
#
# Falls back to RESTART_COOLDOWN_MIN if jot is unavailable or returns
# something that is not a plain positive integer.  This keeps the watchdog
# operational even if jot behaves unexpectedly; the fallback value is
# predictable and safe, just not randomized.
#
# When MIN == MAX the range is degenerate; that case is handled explicitly
# to avoid jot oddities with a zero-width range on some FreeBSD versions.
random_cooldown_seconds() {
  if [ "$RESTART_COOLDOWN_MIN" -eq "$RESTART_COOLDOWN_MAX" ]; then
    printf '%s\n' "$RESTART_COOLDOWN_MIN"
    return
  fi

  if ! command -v jot >/dev/null 2>&1; then
    log_msg "jot not found; falling back to RESTART_COOLDOWN_MIN=${RESTART_COOLDOWN_MIN}"
    printf '%s\n' "$RESTART_COOLDOWN_MIN"
    return
  fi

  value="$(jot -r -w '%d' 1 "$RESTART_COOLDOWN_MIN" "$RESTART_COOLDOWN_MAX" 2>/dev/null)"

  case "$value" in
    ''|*[!0-9]*)
      log_msg "jot returned unexpected value '${value}'; falling back to RESTART_COOLDOWN_MIN=${RESTART_COOLDOWN_MIN}"
      printf '%s\n' "$RESTART_COOLDOWN_MIN"
      ;;
    *)
      printf '%s\n' "$value"
      ;;
  esac
}

# next_restart_epoch NOW
#
# Reads the cooldown state file and returns the epoch timestamp at which
# the next restart attempt is allowed, or 0 if none is recorded.
#
# The file stores a future epoch (now + random cooldown) written at the time
# of the last restart attempt.  Storing the next-allowed time rather than
# the last-attempt time means this function does not need to recompute elapsed
# time or remember which random cooldown was chosen.
#
# NOW must be passed in by the caller so that the future-timestamp comparison
# uses the same reference point as the elapsed calculation in
# cooldown_remaining, avoiding a race if the clock second rolls over between
# two separate date calls.
#
# If the file contains a value more than one maximum cooldown window plus a
# small drift margin past NOW, it is treated as corrupt or the result of a
# large clock jump and is ignored rather than blocking restarts indefinitely.
next_restart_epoch() {
  now="$1"
  if [ ! -r "$NEXT_RESTART_FILE" ]; then
    printf '0\n'
    return
  fi
  value="$(cat "$NEXT_RESTART_FILE" 2>/dev/null)"
  case "$value" in
    ''|*[!0-9]*)
      printf '0\n'
      return
      ;;
  esac
  ceiling=$(( now + RESTART_COOLDOWN_MAX + 60 ))
  if [ "$value" -gt "$ceiling" ]; then
    log_msg "Warning: next_restart_allowed timestamp is implausibly far in the future (${value}); ignoring cooldown state"
    printf '0\n'
  else
    printf '%s\n' "$value"
  fi
}

# cooldown_remaining
#
# Prints the number of seconds until the next restart attempt is allowed, or
# 0 when no valid active cooldown exists.  Handles expired cooldowns and logs
# notable clock skew without blocking restart decisions.
cooldown_remaining() {
  now="$(date '+%s')"
  next="$(next_restart_epoch "$now")"

  if [ "$next" -eq 0 ]; then
    printf '0\n'
    return
  fi

  remaining=$(( next - now ))

  # A non-positive remaining value means the cooldown has expired, or the
  # clock moved forward past the stored next-allowed time (NTP step, VM
  # resume, etc.).  A backward clock step would make remaining larger, which
  # the "implausibly far future" guard in next_restart_epoch handles instead.
  if [ "$remaining" -le 0 ]; then
    if [ "$remaining" -lt -60 ]; then
      log_msg "Warning: clock skew detected (cooldown expired ${remaining} seconds ago); proceeding"
    fi
    printf '0\n'
    return
  fi

  printf '%s\n' "$remaining"
}

# ---- Restart deferral ------------------------------------------------------
#
# The restart impact is global to local Tailscale connectivity, so the first
# deferral implementation samples interface-wide byte counters rather than
# only checking the peer that happened to reach the relay threshold.

# watchdog_sleep SECONDS
#
# Sleeps in a child process and records its PID so signal handling can
# interrupt long main-loop or deferral sleeps promptly.
watchdog_sleep() {
  seconds="$1"
  sleep "$seconds" &
  SLEEP_PID=$!
  wait "$SLEEP_PID"
  rc=$?
  SLEEP_PID=""
  return "$rc"
}

# parse_interface_bytes IFACE
#
# Reads netstat -ibn style output on stdin and prints the total Ibytes+Obytes
# for IFACE.  Returns non-zero when the interface or byte columns are missing.
parse_interface_bytes() {
  iface="$1"

  awk -v iface="$iface" '
    NR == 1 {
      for (i = 1; i <= NF; i++) {
        if ($i == "Ibytes") {
          ibytes = i
        } else if ($i == "Obytes") {
          obytes = i
        }
      }
      next
    }
    $1 == iface {
      if (ibytes == 0 || obytes == 0) {
        exit 2
      }
      if ($ibytes !~ /^[0-9]+$/ || $obytes !~ /^[0-9]+$/) {
        exit 2
      }
      total += $ibytes + $obytes
      found = 1
    }
    END {
      if (!found) {
        exit 1
      }
      printf "%.0f\n", total
    }
  '
}

# get_interface_bytes IFACE
#
# Reads current interface byte counters using FreeBSD netstat and delegates
# parsing to parse_interface_bytes.  A non-zero return means deferral cannot
# safely determine activity.
get_interface_bytes() {
  iface="$1"

  if ! command -v netstat >/dev/null 2>&1; then
    return 1
  fi

  output="$(netstat -ibn -I "$iface" 2>/dev/null)" || return 1
  printf '%s\n' "$output" | parse_interface_bytes "$iface"
}

# should_defer_restart PEER COUNT
#
# Returns 0 when a restart should be deferred because global Tailscale
# interface traffic appears active.  Returns 1 when restart should proceed,
# including disabled deferral, quiet traffic, max attempts, and fail-open
# activity-check errors.  LAST_RESTART_DEFERRAL_* globals describe the result.
should_defer_restart() {
  reason_peer="$1"
  reason_count="$2"
  LAST_RESTART_DEFERRAL_RESULT="disabled"
  LAST_RESTART_DEFERRAL_DELTA=""
  LAST_RESTART_DEFERRAL_ATTEMPTS="$RESTART_DEFERRAL_ATTEMPTS"

  if [ "$RESTART_DEFERRAL_ENABLED" -ne 1 ]; then
    return 1
  fi

  if [ "$RESTART_DEFERRAL_ATTEMPTS" -ge "$RESTART_DEFERRAL_MAX_ATTEMPTS" ]; then
    LAST_RESTART_DEFERRAL_RESULT="max_attempts"
    LAST_RESTART_DEFERRAL_ATTEMPTS="$RESTART_DEFERRAL_ATTEMPTS"
    log_msg "Restart deferral limit reached (${RESTART_DEFERRAL_ATTEMPTS}/${RESTART_DEFERRAL_MAX_ATTEMPTS}); proceeding with restart"
    return 1
  fi

  if ! first="$(get_interface_bytes "$RESTART_DEFERRAL_INTERFACE")"; then
    LAST_RESTART_DEFERRAL_RESULT="check_failed"
    log_msg "Restart deferral activity check failed for interface ${RESTART_DEFERRAL_INTERFACE}; proceeding without deferral"
    return 1
  fi

  if ! watchdog_sleep "$RESTART_DEFERRAL_CHECK_SECONDS"; then
    LAST_RESTART_DEFERRAL_RESULT="interrupted"
    log_msg "Restart deferral sleep interrupted; proceeding without deferral"
    return 1
  fi

  if ! second="$(get_interface_bytes "$RESTART_DEFERRAL_INTERFACE")"; then
    LAST_RESTART_DEFERRAL_RESULT="check_failed"
    log_msg "Restart deferral activity check failed for interface ${RESTART_DEFERRAL_INTERFACE}; proceeding without deferral"
    return 1
  fi

  delta=$(( second - first ))
  LAST_RESTART_DEFERRAL_DELTA="$delta"
  if [ "$delta" -lt 0 ]; then
    LAST_RESTART_DEFERRAL_RESULT="counter_backward"
    log_msg "Restart deferral activity check failed: byte counter moved backward on ${RESTART_DEFERRAL_INTERFACE}; proceeding without deferral"
    return 1
  fi

  if [ "$delta" -le "$RESTART_DEFERRAL_MAX_BYTES" ]; then
    LAST_RESTART_DEFERRAL_RESULT="quiet"
    if [ "$RESTART_DEFERRAL_ATTEMPTS" -gt 0 ]; then
      log_msg "Restart deferral ended: interface ${RESTART_DEFERRAL_INTERFACE} is quiet (${delta} bytes over ${RESTART_DEFERRAL_CHECK_SECONDS}s)"
    fi
    RESTART_DEFERRAL_ATTEMPTS=0
    LAST_RESTART_DEFERRAL_ATTEMPTS="$RESTART_DEFERRAL_ATTEMPTS"
    return 1
  fi

  RESTART_DEFERRAL_ATTEMPTS=$((RESTART_DEFERRAL_ATTEMPTS + 1))
  LAST_RESTART_DEFERRAL_RESULT="busy"
  LAST_RESTART_DEFERRAL_ATTEMPTS="$RESTART_DEFERRAL_ATTEMPTS"
  log_msg "Restart deferred (${RESTART_DEFERRAL_ATTEMPTS}/${RESTART_DEFERRAL_MAX_ATTEMPTS}): interface ${RESTART_DEFERRAL_INTERFACE} saw ${delta} bytes over ${RESTART_DEFERRAL_CHECK_SECONDS}s after peer ${reason_peer} reached ${reason_count}/${FAIL_THRESHOLD} relayed checks"
  return 0
}

# mark_restart_attempt
#
# Atomically writes the next allowed restart epoch before service restart
# commands run.  This consumes cooldown for both successful and failed restart
# attempts, preventing tight retry loops.  LAST_RESTART_* globals expose the
# selected cooldown for later summary logging.
mark_restart_attempt() {
  tmp_next=""
  LAST_RESTART_COOLDOWN=""
  LAST_RESTART_NEXT_ALLOWED=""

  if [ -L "$STATE_DIR" ]; then
    log_msg "State path is a symlink, refusing to write cooldown state: ${STATE_DIR}"
    return 1
  fi
  if [ -e "$STATE_DIR" ] && [ ! -d "$STATE_DIR" ]; then
    log_msg "State path exists but is not a directory: ${STATE_DIR}"
    return 1
  fi
  if ! mkdir -p "$STATE_DIR" 2>/dev/null; then
    log_msg "Could not create state directory: ${STATE_DIR}"
    return 1
  fi
  chmod 0700 "$STATE_DIR" 2>/dev/null || true

  # Choose a random cooldown and compute the next-allowed timestamp.
  # This is done on every restart attempt — success or failure — so that
  # multiple routers monitoring one another do not synchronize their retry
  # timing even when they all fail to restart at the same time.
  cooldown="$(random_cooldown_seconds)"
  now="$(date '+%s')"
  next=$(( now + cooldown ))

  if [ -e "$NEXT_RESTART_FILE" ] && [ ! -f "$NEXT_RESTART_FILE" ]; then
    log_msg "Restart cooldown state path exists but is not a regular file: ${NEXT_RESTART_FILE}"
    return 1
  fi

  tmp_next="$(mktemp "${STATE_DIR}/.next_restart_allowed.XXXXXX")" || {
    log_msg "Could not create temporary restart cooldown state in: ${STATE_DIR}"
    return 1
  }

  if ! printf '%s\n' "$next" > "$tmp_next" 2>/dev/null; then
    rm -f "$tmp_next"
    log_msg "Could not write restart cooldown state: ${NEXT_RESTART_FILE}"
    return 1
  fi
  chmod 0600 "$tmp_next" 2>/dev/null || true

  if ! mv -f "$tmp_next" "$NEXT_RESTART_FILE" 2>/dev/null; then
    rm -f "$tmp_next"
    log_msg "Could not move restart cooldown state into place: ${NEXT_RESTART_FILE}"
    return 1
  fi

  LAST_RESTART_COOLDOWN="$cooldown"
  LAST_RESTART_NEXT_ALLOWED="$next"
  log_msg "Restart cooldown selected: cooldown=${cooldown}s next_allowed_epoch=${next} range=(min=${RESTART_COOLDOWN_MIN}s,max=${RESTART_COOLDOWN_MAX}s)"
  return 0
}

# ---- Tailscale path classification -----------------------------------------
#
# Classification policy:
#
#   direct:
#     At least one "pong from ... via ..." line exists that is not DERP and
#     not peer-relay.  This handles the common case where initial pongs use
#     DERP and later pongs upgrade to a direct path.
#
#   relayed:
#     One or more pongs used DERP or peer-relay, and no direct pong appeared.
#
#   unknown:
#     No usable pong path was found (timeout, peer offline, parse failure).

# classify_ping_output
#
# Reads tailscale ping output from stdin and prints exactly one classification:
# direct, relayed, or unknown.  Direct wins if mixed output contains any direct
# pong because Tailscale can upgrade from DERP to direct during a ping run.
classify_ping_output() {
  awk '
    /^pong from / && / via / {
      if ($0 ~ / via DERP/ || $0 ~ / via peer-relay/) {
        relayed = 1
      } else {
        direct = 1
      }
    }
    END {
      if (direct) {
        print "direct"
      } else if (relayed) {
        print "relayed"
      } else {
        print "unknown"
      }
    }
  '
}

# check_peer_path PEER
#
# Runs tailscale ping and returns the classification (direct/relayed/unknown)
# on stdout.  All debug output goes to stderr so that the return value on
# stdout is always exactly one word and is safe to capture with $().
check_peer_path() {
  peer="$1"
  output="$(tailscale ping -c "$PING_COUNT" "$peer" 2>&1)"
  rc=$?
  class="$(printf '%s\n' "$output" | classify_ping_output)"
  if [ "$DEBUG" -eq 1 ]; then
    debug_msg "peer=${peer} class=${class} tailscale_ping_rc=${rc}"
    printf '%s\n' "$output" | sed 's/^/  /' >&2
  fi
  printf '%s\n' "$class"
}

# ---- Restart handling ------------------------------------------------------

# run_service_command SERVICE ACTION
#
# Runs `service SERVICE ACTION`, leaving the exit status in SVC_RC and any
# output in SVC_OUTPUT.
#
# Output goes to a temp file rather than a command substitution, and that is
# load-bearing rather than stylistic.  A command substitution makes the child
# write into a pipe whose read end is this daemon.  If the rc wrapper escalates
# to SIGKILL while a start is still running, the daemon dies, the pipe closes,
# and the orphaned `service` is killed by SIGPIPE at its next write -- leaving
# the service stopped and never started, which is the state the whole deferral
# path exists to avoid.  Writing to a file leaves the orphan's stdout valid, so
# it runs to completion even though nothing is left to read the result.
run_service_command() {
  SVC_RC=0
  SVC_OUTPUT=""

  _rsc_log="$(mktemp "$SERVICE_OUTPUT_TEMPLATE" 2>/dev/null)" || _rsc_log=""
  if [ -z "$_rsc_log" ]; then
    # Losing the diagnostic is better than reintroducing the pipe.
    service "$1" "$2" >/dev/null 2>&1
    SVC_RC=$?
    SVC_OUTPUT="(output unavailable: could not create temp file)"
    log_msg "Could not create a temp file for ${1} ${2} output; diagnostics for this command are unavailable"
    unset _rsc_log
    return 0
  fi

  service "$1" "$2" >"$_rsc_log" 2>&1
  SVC_RC=$?
  # Safe as a command substitution: cat is immediate, and the service command
  # it is reading for has already finished.
  SVC_OUTPUT="$(cat "$_rsc_log" 2>/dev/null)"
  rm -f "$_rsc_log"
  unset _rsc_log
}

# warn_ignored_state_paths CONFIG_STATE_DIR CONFIG_NEXT_RESTART_FILE
#
# Logs when the live config assigned a state path that reset_runtime_state has
# just discarded.  Both are fixed rather than settings -- see the comments in
# reset_runtime_state -- but a config assigning one used to split the pair and
# suppress every restart, so an operator who tried it deserves to see why it
# had no effect instead of finding a watchdog that quietly stopped restarting.
warn_ignored_state_paths() {
  if [ -n "$1" ] && [ "$1" != "$STATE_DIR" ]; then
    log_msg "Ignoring STATE_DIR from the config (${1}). The runtime state directory is fixed at ${STATE_DIR}; the uninstaller removes only that path. See ${DOCS_URL}"
  fi
  if [ -n "$2" ] && [ "$2" != "$NEXT_RESTART_FILE" ]; then
    log_msg "Ignoring NEXT_RESTART_FILE from the config (${2}). The cooldown state file is fixed at ${NEXT_RESTART_FILE}. See ${DOCS_URL}"
  fi
}

# warn_redundant_restart_services
#
# Logs a startup warning when RESTART_SERVICES lists tailscaled alongside
# pfsense_tailscaled.  Installers preserve the live config, so a config written
# before the default changed keeps the old two-service list and never sees the
# README note about it.  pfsense_tailscaled's own stop and start already cycle
# tailscaled, so the extra entry doubles the number of windows in which the
# router has Tailscale stopped, for no benefit.  Advisory only: RESTART_SERVICES
# is the operator's to set.
warn_redundant_restart_services() {
  _wsvc_has_tailscaled=0
  _wsvc_has_pfsense=0
  _wsvc_noglob=0
  case $- in
    *f*) _wsvc_noglob=1 ;;
    *) set -f ;;
  esac
  for _wsvc in $RESTART_SERVICES; do
    case "$_wsvc" in
      tailscaled) _wsvc_has_tailscaled=1 ;;
      pfsense_tailscaled) _wsvc_has_pfsense=1 ;;
    esac
  done
  if [ "$_wsvc_noglob" -eq 0 ]; then
    set +f
  fi

  if [ "$_wsvc_has_tailscaled" -eq 1 ] && [ "$_wsvc_has_pfsense" -eq 1 ]; then
    log_msg "RESTART_SERVICES lists both tailscaled and pfsense_tailscaled; restarting pfsense_tailscaled alone already cycles tailscaled. Consider RESTART_SERVICES=\"pfsense_tailscaled\". See ${DOCS_URL}"
  fi

  unset _wsvc_has_tailscaled _wsvc_has_pfsense _wsvc_noglob _wsvc
}

# restart_tailscale_services PEER COUNT
#
# Marks cooldown, restarts each configured service, sends optional notification,
# and resets all peer state only if every service restart succeeds.  On failure,
# counters are preserved so retry can happen after cooldown.
restart_tailscale_services() {
  reason_peer="$1"
  reason_count="$2"
  failures=0

  log_msg "Restarting Tailscale services after peer ${reason_peer} was relayed for ${reason_count} consecutive checks"

  # Write the next-allowed restart timestamp before attempting the restart.
  # Done regardless of whether the restart succeeds so that a failed restart
  # does not leave multiple routers free to retry in lockstep.
  if ! mark_restart_attempt; then
    log_msg "Restart suppressed: could not write restart cooldown state"
    return 1
  fi

  _noglob_was_set=0
  case $- in
    *f*) _noglob_was_set=1 ;;
    *) set -f ;;
  esac
  # Everything from the first stop to the last start is a critical section.  A
  # TERM arriving in it must not exit the daemon between a stop and a start:
  # POSIX defers a trapped signal until the running foreground command finishes
  # and then runs the trap, so a plain exit there would skip the start and leave
  # Tailscale down.  handle_shutdown records the request instead; the exit
  # happens below, after the loop and after the shell options are restored.
  #
  # Do not add an early return between here and the matching RESTART_CRITICAL=0
  # below.  Leaving the flag set would make handle_shutdown defer every later
  # signal, and the daemon would never stop again without SIGKILL.
  RESTART_CRITICAL=1
  for svc in $RESTART_SERVICES; do
    if [ "$SHUTDOWN_PENDING" -eq 1 ]; then
      # A service this loop has not reached yet is in a safe state: it is still
      # running.  Stopping it now would open a fresh stop-to-start window on a
      # deadline the pending shutdown has already partly spent, and the daemon
      # is about to exit either way, so the restart buys nothing.  Every service
      # already stopped has had its start issued; leave the rest alone.
      log_msg "Shutdown pending; leaving ${svc} running rather than starting another stop/start"
      break
    fi

    # Stop and start as separate invocations rather than `service ... restart`.
    #
    # This mirrors the pfSense GUI's service control (restart_service() in
    # service-utils.inc), which runs the rc file's stop, then its start, as two
    # processes.  rc.subr's `restart` instead runs `( stop )` and `( start )`
    # back to back in one shell with no gap.
    #
    # The gap matters.  pfsense_tailscaled does the work that makes a restart
    # actually restore a direct path -- `tailscale up` with the configured
    # flags, re-adding tailscale0 to the Tailscale interface group, and
    # reloading the packet filter -- in its rc.d post-start hook.  That hook
    # gives tailscale0 only a few seconds to reappear and returns early if it
    # does not, silently skipping all three steps.  rc.subr also skips the
    # post-start hook entirely when the start command reports the daemon is
    # still running.  Restarting with no settling time is the shape most likely
    # to hit either case and leave Tailscale up but relay-only.
    run_service_command "$svc" stop
    stop_rc="$SVC_RC"
    stop_output="$SVC_OUTPUT"
    if [ "$stop_rc" -ne 0 ]; then
      # Not a failure.  The GUI skips the stop when the service is not running,
      # and pfsense_tailscaled's stop returns non-zero when tailscaled is
      # already down.  Only the start decides whether the restart succeeded.
      #
      # Logged through log_msg rather than debug_msg so it reaches syslog.  A
      # stop that keeps failing for some other reason is the one condition that
      # makes this whole sequence ineffective, because rc.subr skips the
      # post-start hook when the start finds the daemon still running -- and
      # the restart would still be reported as successful.
      log_msg "Service stop returned rc=${stop_rc} for ${svc}; continuing to start; output=${stop_output}"
    fi

    if [ "$RESTART_SETTLE_SECONDS" -gt 0 ] && [ "$SHUTDOWN_PENDING" -eq 0 ]; then
      # A plain sleep, not watchdog_sleep.  watchdog_sleep exists so the main
      # loop's inter-check wait can be cut short by a signal, which needs
      # SLEEP_PID bookkeeping that only makes sense outside a restart.  Here the
      # critical section is what keeps a signal from stripping the start, so the
      # sleep does not need to be interruptible.
      #
      # Skipped once a shutdown is pending.  Combined with the break above, the
      # most the SIGKILL deadline has to cover after the signal is one settle
      # plus one start -- the settle only when the signal lands inside a pause
      # already sleeping, which the guard below cannot prevent.  The cap is
      # sized so that pause plus a start still fits the wrapper's window; do
      # not read this as "the start gets the whole budget".
      #
      # It costs settling time on exactly the restart that cannot be retried,
      # which is a real loss and not a marginal one: with the single-service
      # default this is the only settle there is, and the settle is what keeps
      # rc.subr from skipping the post-start hook.  It is still the right trade,
      # because the failure modes are not symmetric -- a service left stopped is
      # unrecoverable and takes remote access with it, while a restart that
      # comes back relayed is merely no better than before.
      #
      # A settle already sleeping still runs to completion -- the trap cannot
      # run until the sleep returns -- so at most one full settle sits on the
      # deadline path, and only when the signal arrives during it.  That single
      # pause is what the cap in validate_config is sized against.
      sleep "$RESTART_SETTLE_SECONDS"
    fi

    run_service_command "$svc" start
    rc="$SVC_RC"
    output="$SVC_OUTPUT"
    if [ "$rc" -eq 0 ]; then
      log_msg "Service restarted successfully: ${svc}"
    else
      failures=$((failures + 1))
      log_msg "Service restart FAILED: ${svc}; rc=${rc}; output=${output}"
    fi
  done
  if [ "$_noglob_was_set" -eq 0 ]; then
    set +f
  fi
  unset _noglob_was_set

  # End of the critical section.  Every service that was stopped has had its
  # start attempted, so it is safe to honour a shutdown that arrived meanwhile.
  # Done before the notification block deliberately: rc.d allows only a few
  # seconds before escalating to SIGKILL, and spending them on a curl call
  # rather than exiting would risk being killed anyway.
  RESTART_CRITICAL=0
  if [ "$SHUTDOWN_PENDING" -eq 1 ]; then
    handle_shutdown
  fi

  if [ "$failures" -eq 0 ]; then
    msg="Tailscale watchdog: restarted ${RESTART_SERVICES} after peer ${reason_peer} was relayed for ${reason_count} consecutive checks."
    log_msg "$msg"
    if notifications_may_send; then
      router_name="$(local_tailscale_name)"
      notify \
        "$(restart_notification_title "$router_name" success)" \
        "$(restart_notification_message "$router_name" success "$reason_peer" "$reason_count")"
    else
      notify "$msg"
    fi
    reset_all_peer_state_after_restart
    return 0
  fi

  msg="Tailscale watchdog: restart FAILED after peer ${reason_peer} was relayed for ${reason_count} consecutive checks."
  log_msg "$msg"
  if notifications_may_send; then
    router_name="$(local_tailscale_name)"
    notify \
      "$(restart_notification_title "$router_name" failure)" \
      "$(restart_notification_message "$router_name" failure "$reason_peer" "$reason_count")"
  else
    notify "$msg"
  fi
  return 1
}

# maybe_restart_for_peer PEER COUNT
#
# Applies threshold, test-mode, cooldown, and deferral gates for one peer that
# has just been classified relayed.  Emits the compact restart-decision summary
# used for operational troubleshooting.
maybe_restart_for_peer() {
  peer="$1"
  count="$2"
  decision_peer="$peer"
  decision_count="$count"

  if [ "$count" -lt "$FAIL_THRESHOLD" ]; then
    return 0
  fi

  if [ "$TEST" -eq 1 ]; then
    seen="$(get_peer_attr threshold_seen "$peer" none)"
    if [ "$seen" != "test" ]; then
      log_msg "Restart decision: peer=${decision_peer} count=${decision_count}/${FAIL_THRESHOLD} cooldown=not_checked deferral=not_checked action=test would_restart=\"${RESTART_SERVICES}\""
      log_msg "TEST MODE: peer ${peer} reached ${count}/${FAIL_THRESHOLD} relayed checks; would restart ${RESTART_SERVICES}"
      set_peer_attr threshold_seen "$peer" test
    fi
    return 0
  fi

  remaining="$(cooldown_remaining)"
  if [ "$remaining" -gt 0 ]; then
    seen="$(get_peer_attr threshold_seen "$peer" none)"
    if [ "$seen" != "cooldown" ]; then
      log_msg "Restart decision: peer=${decision_peer} count=${decision_count}/${FAIL_THRESHOLD} cooldown=blocked remaining=${remaining}s deferral=not_checked action=suppress"
      log_msg "Peer ${peer} reached ${count}/${FAIL_THRESHOLD} relayed checks, but restart is suppressed by cooldown for ${remaining} more seconds"
      set_peer_attr threshold_seen "$peer" cooldown
    fi
    return 0
  fi

  if should_defer_restart "$decision_peer" "$decision_count"; then
    log_msg "Restart decision: peer=${decision_peer} count=${decision_count}/${FAIL_THRESHOLD} cooldown=allowed deferral=busy attempts=${LAST_RESTART_DEFERRAL_ATTEMPTS}/${RESTART_DEFERRAL_MAX_ATTEMPTS} delta=${LAST_RESTART_DEFERRAL_DELTA} action=defer"
    set_peer_attr threshold_seen "$decision_peer" deferral
    return 0
  fi

  deferral_result="${LAST_RESTART_DEFERRAL_RESULT:-disabled}"
  if restart_tailscale_services "$decision_peer" "$decision_count"; then
    selected="${LAST_RESTART_COOLDOWN:-unknown}"
    next_allowed="${LAST_RESTART_NEXT_ALLOWED:-unknown}"
    log_msg "Restart decision: peer=${decision_peer} count=${decision_count}/${FAIL_THRESHOLD} cooldown=selected selected=${selected}s next_allowed_epoch=${next_allowed} deferral=${deferral_result} action=restart services=\"${RESTART_SERVICES}\" result=success"
    return 0
  fi

  if [ -n "$LAST_RESTART_COOLDOWN" ]; then
    log_msg "Restart decision: peer=${decision_peer} count=${decision_count}/${FAIL_THRESHOLD} cooldown=selected selected=${LAST_RESTART_COOLDOWN}s next_allowed_epoch=${LAST_RESTART_NEXT_ALLOWED} deferral=${deferral_result} action=restart services=\"${RESTART_SERVICES}\" result=failed"
  else
    log_msg "Restart decision: peer=${decision_peer} count=${decision_count}/${FAIL_THRESHOLD} cooldown=write_failed deferral=${deferral_result} action=suppress"
  fi
  return 1
}

# ---- Per-peer state machine ------------------------------------------------

# handle_direct PEER
#
# Handles a direct classification by clearing the peer's relay counter and
# threshold marker, then clearing global deferral state if no threshold remains.
handle_direct() {
  peer="$1"
  count="$(get_peer_attr count "$peer" 0)"
  state="$(get_peer_attr state "$peer" unknown)"

  case "$state" in
    direct)
      ;;
    relayed|post_restart)
      log_msg "Peer ${peer} is direct (was ${state}; relay counter was ${count})"
      ;;
    *)
      log_msg "Peer ${peer} is direct (initial classification; was: ${state})"
      ;;
  esac

  set_peer_attr count "$peer" 0
  set_peer_attr state "$peer" direct
  set_peer_attr threshold_seen "$peer" none
  reset_restart_deferral_if_no_threshold
}

# handle_relayed PEER
#
# Handles a relayed classification by incrementing the peer's consecutive
# relayed count and then evaluating restart eligibility.
handle_relayed() {
  peer="$1"
  count="$(get_peer_attr count "$peer" 0)"
  count=$((count + 1))
  set_peer_attr count "$peer" "$count"
  set_peer_attr state "$peer" relayed
  log_msg "Peer ${peer} is relayed; consecutive relayed checks=${count}/${FAIL_THRESHOLD}"
  maybe_restart_for_peer "$peer" "$count"
}

# handle_unknown PEER
#
# Handles unclassifiable ping output by breaking the consecutive-relay
# sequence.  Unknown is deliberately not evidence for restart.
handle_unknown() {
  peer="$1"
  count="$(get_peer_attr count "$peer" 0)"
  state="$(get_peer_attr state "$peer" unknown)"

  if [ "$count" -gt 0 ]; then
    log_msg "Peer ${peer} path is unknown; breaking relayed sequence and resetting counter from ${count}"
  elif [ "$state" != "unknown" ]; then
    log_msg "Peer ${peer} path is unknown (was ${state})"
  fi

  set_peer_attr count "$peer" 0
  set_peer_attr state "$peer" unknown
  set_peer_attr threshold_seen "$peer" none
  reset_restart_deferral_if_no_threshold
}

# check_peer PEER
#
# Runs one peer through ping classification and dispatches to the state
# transition handler for the resulting class.
check_peer() {
  peer="$1"
  class="$(check_peer_path "$peer")"
  case "$class" in
    direct)
      handle_direct "$peer"
      ;;
    relayed)
      handle_relayed "$peer"
      ;;
    *)
      handle_unknown "$peer"
      ;;
  esac
}

# check_all_peers
#
# Checks every configured peer once.  Globbing is disabled around PEERS word
# splitting so peer names are treated as literal configured tokens.
check_all_peers() {
  _noglob_was_set=0
  case $- in
    *f*) _noglob_was_set=1 ;;
    *) set -f ;;
  esac
  for peer in $PEERS; do
    check_peer "$peer"
  done
  if [ "$_noglob_was_set" -eq 0 ]; then
    set +f
  fi
  unset _noglob_was_set
}

# ---- Signal handling -------------------------------------------------------

# handle_shutdown
#
# Handles TERM/INT by logging shutdown and interrupting any active sleep before
# exiting.  This keeps rc.d stop responsive even during long intervals.
#
# One exception: while a service restart is between its stop and its start,
# exiting would leave Tailscale stopped on the router with nothing to bring it
# back.  A watchdog that starts up against a dead Tailscale classifies every
# peer as unknown, and unknown breaks the relayed sequence, so it would never
# restart the service on its own.  In that window the request is recorded and
# restart_tailscale_services exits once the start has run.
handle_shutdown() {
  if [ "$RESTART_CRITICAL" -eq 1 ]; then
    SHUTDOWN_PENDING=1
    log_msg "Shutdown requested during a service restart; completing the restart first"
    return 0
  fi
  log_msg "Daemon stopping"
  if [ -n "$SLEEP_PID" ]; then
    kill "$SLEEP_PID" 2>/dev/null
    SLEEP_PID=""
  fi
  exit 0
}

# main ARGS...
#
# Loads config, applies CLI overrides, validates final settings, installs
# signal handlers, logs startup, and runs either one check cycle or the daemon
# loop.  Kept out of test mode so tests can source functions safely.
main() {
  # ---- Config path pre-scan ------------------------------------------------

  next_is_config=0
  for arg in "$@"; do
    if [ "$next_is_config" -eq 1 ]; then
      CONFIG_FILE="$arg"
      next_is_config=0
      continue
    fi
    case "$arg" in
      -f)
        next_is_config=1
        ;;
      -f*)
        CONFIG_FILE="${arg#-f}"
        ;;
    esac
  done
  unset next_is_config arg

  load_config_file "$CONFIG_FILE"

  # Discard anything the live config assigned to internal runtime state.  See
  # reset_runtime_state for why, and for what each of those values reaches.
  #
  # The state paths are captured first so the reset can be reported.  Silently
  # ignoring a config line leaves an operator watching a setting do nothing
  # with no way to tell that it was rejected rather than broken.
  _cfg_state_dir="${STATE_DIR:-}"
  _cfg_next_restart_file="${NEXT_RESTART_FILE:-}"

  reset_runtime_state

  # ---- Option parsing ------------------------------------------------------
  OPTIND=1
  while getopts "t1df:i:n:c:h" opt; do
    case "$opt" in
      t)
        TEST=1
        ;;
      1)
        ONE_SHOT=1
        ;;
      d)
        DEBUG=1
        ;;
      f)
        CONFIG_FILE="$OPTARG"
        ;;
      i)
        if ! is_positive_int "$OPTARG"; then
          echo "Invalid interval: $OPTARG" >&2
          usage
          exit 2
        fi
        CHECK_INTERVAL="$OPTARG"
        ;;
      n)
        if ! is_positive_int "$OPTARG"; then
          echo "Invalid threshold: $OPTARG" >&2
          usage
          exit 2
        fi
        FAIL_THRESHOLD="$OPTARG"
        ;;
      c)
        if ! is_positive_int "$OPTARG"; then
          echo "Invalid ping count: $OPTARG" >&2
          usage
          exit 2
        fi
        PING_COUNT="$OPTARG"
        ;;
      h|*)
        usage
        exit 2
        ;;
    esac
  done
  shift $((OPTIND - 1))

  if [ "$#" -ne 0 ]; then
    usage
    exit 2
  fi

  validate_config

  trap handle_shutdown INT TERM

  log_msg "Daemon started: config=${CONFIG_FILE} peers=\"${PEERS}\" interval=${CHECK_INTERVAL}s threshold=${FAIL_THRESHOLD} ping_count=${PING_COUNT} cooldown=(min=${RESTART_COOLDOWN_MIN}s,max=${RESTART_COOLDOWN_MAX}s) restart_services=\"${RESTART_SERVICES}\" restart_settle=${RESTART_SETTLE_SECONDS}s restart_deferral_enabled=${RESTART_DEFERRAL_ENABLED} restart_deferral_interface=${RESTART_DEFERRAL_INTERFACE} test=${TEST} docs=${DOCS_URL}"
  # Reported here rather than beside the reset above so that -d reaches it:
  # DEBUG is still 0 before option parsing, so log_msg would go to syslog only.
  warn_ignored_state_paths "$_cfg_state_dir" "$_cfg_next_restart_file"
  unset _cfg_state_dir _cfg_next_restart_file
  warn_redundant_restart_services
  notify_startup_if_enabled

  if [ "$ONE_SHOT" -eq 1 ]; then
    check_all_peers
    exit 0
  fi

  while :; do
    check_all_peers
    watchdog_sleep "$CHECK_INTERVAL"
  done
}

if [ "${TAILSCALE_WATCHDOG_TESTING:-0}" != "1" ]; then
  main "$@"
fi

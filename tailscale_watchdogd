#!/bin/sh
#
# tailscale_watchdogd
#
# Foreground daemon that checks selected Tailscale peers once per interval.
# If a peer is relayed for FAIL_THRESHOLD consecutive checks, restart
# tailscaled and pfsense_tailscaled, then send a Pushover notification.
#
# Documentation:
#   https://github.com/toddawhittaker/tailscale-direct-pfsense
#
# Normal healthy operation performs no per-minute disk writes.
#
# Usage:
#   tailscale_watchdogd [-t] [-1] [-d] [-f config_file] [-i seconds] [-n threshold] [-c ping_count]
#
# Options:
#   -t    Test mode: never restart services.
#   -1    One-shot mode: run one check cycle and exit.
#   -d    Debug mode: print classifications and tailscale ping output to stderr.
#   -f    Config file path. Default: /usr/local/etc/tailscale_watchdog.conf.
#   -i    Check interval in seconds. Overrides config/default.
#   -n    Consecutive relayed checks required before restart. Overrides config/default.
#   -c    tailscale ping count. Overrides config/default.
#
# Security notes:
#   - The config file must be owned by root and not readable, writable, or
#     executable by group or world (mode 0600 recommended).  Permissions are
#     verified with stat(1) before sourcing.
#   - Pushover credentials are passed to curl through a config stream on stdin,
#     not as process arguments.
#   - Peer names are validated to contain only hostname-safe characters before
#     being passed to tailscale ping, and checked for post-sanitization
#     collisions that would cause two peers to share the same state counter.
#
PATH="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"
TAG="tailscale_watchdog"
DOCS_URL="https://github.com/toddawhittaker/tailscale-direct-pfsense"

# ---- Configuration defaults ------------------------------------------------
#
# These defaults may be overridden by the config file.
# Command-line flags override both defaults and config-file values.
CONFIG_FILE="/usr/local/etc/tailscale_watchdog.conf"
PUSHOVER_TOKEN=""
PUSHOVER_USER=""
PEERS="router1 router2"
CHECK_INTERVAL=60
FAIL_THRESHOLD=5
PING_COUNT=5
# Minimum and maximum seconds after a restart attempt before another restart
# is allowed.  After each restart attempt a random value in this range is
# chosen as the cooldown for that router.  Using a range rather than a fixed
# value prevents multiple routers that monitor one another from settling into
# synchronized restart cycles: each picks its own next-allowed time
# independently, so they naturally spread apart even if they restart together.
#
# Example with three routers and RESTART_COOLDOWN_MIN=900 / MAX=2700:
#   router1 restarts -> next restart allowed in 1248 seconds
#   router2 restarts -> next restart allowed in 2341 seconds
#   router3 restarts -> next restart allowed in 987 seconds
#
# Set MIN and MAX to the same value to get a fixed cooldown.
RESTART_COOLDOWN_MIN=900
RESTART_COOLDOWN_MAX=2700
RESTART_SERVICES="tailscaled pfsense_tailscaled"
RESTART_DEFERRAL_ENABLED=1
RESTART_DEFERRAL_INTERFACE="tailscale0"
RESTART_DEFERRAL_CHECK_SECONDS=30
RESTART_DEFERRAL_MAX_BYTES=65536
RESTART_DEFERRAL_MAX_ATTEMPTS=10
STATE_DIR="/var/run/tailscale_watchdog"
# The state file stores the epoch timestamp at which the next restart attempt
# is allowed.  It is written after every restart attempt (success or failure)
# with a randomly chosen value between now+MIN and now+MAX.  Storing the
# next-allowed time rather than the last-attempt time means cooldown_remaining
# does not need to recompute elapsed time or remember which random cooldown
# was chosen.
NEXT_RESTART_FILE="${STATE_DIR}/next_restart_allowed"
CURL_TIMEOUT=10

# ---- Runtime flags ---------------------------------------------------------
TEST=0
ONE_SHOT=0
DEBUG=0
RESTART_DEFERRAL_ATTEMPTS=0
LAST_RESTART_COOLDOWN=""
LAST_RESTART_NEXT_ALLOWED=""
LAST_RESTART_DEFERRAL_RESULT=""
LAST_RESTART_DEFERRAL_DELTA=""
LAST_RESTART_DEFERRAL_ATTEMPTS=""

# Holds the PID of the background sleep process during the main loop so that
# handle_shutdown can kill it promptly on SIGTERM/SIGINT.
SLEEP_PID=""

# ---- Utility functions -----------------------------------------------------

# usage
#
# Prints command-line usage to stderr.  This function does not exit so callers
# can choose the correct exit status for parse errors or help output.
usage() {
  cat >&2 <<EOF
Usage: $0 [-t] [-1] [-d] [-f config_file] [-i seconds] [-n threshold] [-c ping_count]
Options:
  -t    Test mode: never restart services.
  -1    One-shot mode: run one check cycle and exit.
  -d    Debug mode: print classifications and tailscale ping output to stderr.
  -f    Config file path. Default: ${CONFIG_FILE}.
  -i    Check interval in seconds. Default: ${CHECK_INTERVAL}.
  -n    Consecutive relayed checks required before restart. Default: ${FAIL_THRESHOLD}.
  -c    tailscale ping count. Default: ${PING_COUNT}.
EOF
}

# is_positive_int VALUE
#
# Returns 0 for a non-empty decimal integer greater than zero.  Used for
# config and CLI validation before values reach arithmetic contexts.
is_positive_int() {
  case "$1" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac
  [ "$1" -gt 0 ] 2>/dev/null
}

# is_bool VALUE
#
# Returns 0 only for the config booleans accepted by this script: 0 or 1.
is_bool() {
  case "$1" in
    0|1)
      return 0
      ;;
  esac
  return 1
}

# log_msg MESSAGE...
#
# Writes operational logs through logger(1), and mirrors them to stderr in
# debug mode.  This must never write to stdout because it is called from
# functions that may run inside command substitutions.
log_msg() {
  logger -t "$TAG" "$*"
  if [ "$DEBUG" -eq 1 ]; then
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2
  fi
}

# debug_msg MESSAGE...
#
# Writes debug-only diagnostics to stderr.  Keep stdout clean so callers can
# safely capture function return values such as path classifications.
debug_msg() {
  if [ "$DEBUG" -eq 1 ]; then
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2
  fi
}

# config_is_safe_to_source FILE
#
# Verifies that FILE is:
#   - a regular file
#   - readable by the current process
#   - owned by root
#   - has no group or world permissions set (mode 0600 or stricter)
#
# Uses stat(1) rather than parsing ls(1) output, which avoids fragile
# positional pattern matching on permission strings that vary across systems
# and can include ACL indicator characters.
#
# stat -f '%Su' returns the owning username.
# stat -f '%Lp' returns the numeric permission bits in octal as a 3- or
# 4-digit string (e.g. "600", "644", "755").  The leading-zero form
# $(( 0$octal & 077 )) causes the shell to interpret the value as octal
# without requiring the non-POSIX 8# base prefix.
config_is_safe_to_source() {
  file="$1"

  if [ ! -f "$file" ]; then
    echo "Config file is not a regular file: $file" >&2
    return 1
  fi

  if [ ! -r "$file" ]; then
    echo "Config file is not readable: $file" >&2
    return 1
  fi

  if ! command -v stat >/dev/null 2>&1; then
    echo "stat(1) not found; cannot verify config file permissions" >&2
    return 1
  fi

  owner="$(stat -f '%Su' "$file" 2>/dev/null)"
  if [ "$owner" != "root" ]; then
    echo "Config file must be owned by root: $file (current owner: ${owner:-unknown})" >&2
    echo "Run: chown root:wheel $file" >&2
    return 1
  fi

  octal="$(stat -f '%Lp' "$file" 2>/dev/null)"

  case "$octal" in
    [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7])
      ;;
    *)
      echo "Could not determine permissions for config file: $file (stat returned: '${octal}')" >&2
      return 1
      ;;
  esac

  if [ "$(( 0${octal} & 077 ))" -ne 0 ]; then
    echo "Config file must not have group or world permissions: $file (mode: ${octal})" >&2
    echo "Run: chmod 0600 $file" >&2
    return 1
  fi

  return 0
}

# load_config_file FILE
#
# Verifies and sources the live config, then restores the known-safe PATH so
# config content cannot alter command lookup for later privileged operations.
load_config_file() {
  file="$1"

  if [ ! -e "$file" ]; then
    echo "Config file not found: $file" >&2
    exit 2
  fi

  if ! config_is_safe_to_source "$file"; then
    exit 2
  fi

  . "$file"

  PATH="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"
  return 0
}

# validate_config
#
# Validates sourced config values after CLI overrides are applied.  This is
# the boundary that turns shell-sourced text into constrained peer names,
# service names, intervals, cooldowns, and deferral settings.
validate_config() {
  if [ -z "$PEERS" ]; then
    echo "PEERS must not be empty" >&2
    exit 2
  fi

  _seen_safe=""
  _noglob_was_set=0
  case $- in
    *f*) _noglob_was_set=1 ;;
    *) set -f ;;
  esac
  for _vpeer in $PEERS; do
    case "$_vpeer" in
      -*)
        echo "Invalid peer name (contains shell-unsafe characters): ${_vpeer}" >&2
        exit 2
        ;;
      *[!A-Za-z0-9._-]*)
        echo "Invalid peer name (contains shell-unsafe characters): ${_vpeer}" >&2
        exit 2
        ;;
    esac
    _vsafe="$(safe_peer_name "$_vpeer")"
    case " ${_seen_safe} " in
      *" ${_vsafe} "*)
        echo "Invalid peer list: '${_vpeer}' collides with another peer after sanitization as '${_vsafe}'" >&2
        exit 2
        ;;
    esac
    _seen_safe="${_seen_safe} ${_vsafe}"
  done
  if [ "$_noglob_was_set" -eq 0 ]; then
    set +f
  fi
  unset _vpeer _vsafe _seen_safe _noglob_was_set

  if ! is_positive_int "$CHECK_INTERVAL"; then
    echo "CHECK_INTERVAL must be a positive integer: $CHECK_INTERVAL" >&2
    exit 2
  fi
  if ! is_positive_int "$FAIL_THRESHOLD"; then
    echo "FAIL_THRESHOLD must be a positive integer: $FAIL_THRESHOLD" >&2
    exit 2
  fi
  if ! is_positive_int "$PING_COUNT"; then
    echo "PING_COUNT must be a positive integer: $PING_COUNT" >&2
    exit 2
  fi
  if ! is_positive_int "$RESTART_COOLDOWN_MIN"; then
    echo "RESTART_COOLDOWN_MIN must be a positive integer: $RESTART_COOLDOWN_MIN" >&2
    exit 2
  fi
  if ! is_positive_int "$RESTART_COOLDOWN_MAX"; then
    echo "RESTART_COOLDOWN_MAX must be a positive integer: $RESTART_COOLDOWN_MAX" >&2
    exit 2
  fi
  if [ "$RESTART_COOLDOWN_MAX" -lt "$RESTART_COOLDOWN_MIN" ]; then
    echo "RESTART_COOLDOWN_MAX (${RESTART_COOLDOWN_MAX}) must be >= RESTART_COOLDOWN_MIN (${RESTART_COOLDOWN_MIN})" >&2
    exit 2
  fi
  if ! is_positive_int "$CURL_TIMEOUT"; then
    echo "CURL_TIMEOUT must be a positive integer: $CURL_TIMEOUT" >&2
    exit 2
  fi
  if ! is_bool "$RESTART_DEFERRAL_ENABLED"; then
    echo "RESTART_DEFERRAL_ENABLED must be 0 or 1: $RESTART_DEFERRAL_ENABLED" >&2
    exit 2
  fi
  if [ -z "$RESTART_DEFERRAL_INTERFACE" ]; then
    echo "RESTART_DEFERRAL_INTERFACE must not be empty" >&2
    exit 2
  fi
  case "$RESTART_DEFERRAL_INTERFACE" in
    -*|*[!A-Za-z0-9._-]*)
      echo "Invalid restart deferral interface (contains shell-unsafe characters): ${RESTART_DEFERRAL_INTERFACE}" >&2
      exit 2
      ;;
  esac
  if ! is_positive_int "$RESTART_DEFERRAL_CHECK_SECONDS"; then
    echo "RESTART_DEFERRAL_CHECK_SECONDS must be a positive integer: $RESTART_DEFERRAL_CHECK_SECONDS" >&2
    exit 2
  fi
  if ! is_positive_int "$RESTART_DEFERRAL_MAX_BYTES"; then
    echo "RESTART_DEFERRAL_MAX_BYTES must be a positive integer: $RESTART_DEFERRAL_MAX_BYTES" >&2
    exit 2
  fi
  if ! is_positive_int "$RESTART_DEFERRAL_MAX_ATTEMPTS"; then
    echo "RESTART_DEFERRAL_MAX_ATTEMPTS must be a positive integer: $RESTART_DEFERRAL_MAX_ATTEMPTS" >&2
    exit 2
  fi
  if [ -z "$RESTART_SERVICES" ]; then
    echo "RESTART_SERVICES must not be empty" >&2
    exit 2
  fi
  _noglob_was_set=0
  case $- in
    *f*) _noglob_was_set=1 ;;
    *) set -f ;;
  esac
  for _vsvc in $RESTART_SERVICES; do
    case "$_vsvc" in
      -*)
        echo "Invalid service name (contains shell-unsafe characters): ${_vsvc}" >&2
        exit 2
        ;;
      *[!A-Za-z0-9._-]*)
        echo "Invalid service name (contains shell-unsafe characters): ${_vsvc}" >&2
        exit 2
        ;;
    esac
  done
  if [ "$_noglob_was_set" -eq 0 ]; then
    set +f
  fi
  unset _vsvc _noglob_was_set
}

# curl_config_escape VALUE
#
# Escapes backslashes and double quotes for values written to curl's -K
# config stream.  This keeps Pushover credentials out of process arguments.
curl_config_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# notify MESSAGE
#
# Sends an optional Pushover notification.  Missing credentials are a clean
# no-op; curl failures are logged but do not alter restart state.
notify() {
  message="$1"

  if [ -z "$PUSHOVER_TOKEN" ] || [ -z "$PUSHOVER_USER" ]; then
    log_msg "Pushover notification skipped: token or user key is empty"
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    log_msg "Pushover notification failed: curl not found"
    return 1
  fi

  if ! {
    printf 'fail\n'
    printf 'show-error\n'
    printf 'silent\n'
    printf 'max-time = "%s"\n' "$(curl_config_escape "$CURL_TIMEOUT")"
    printf 'url = "https://api.pushover.net/1/messages.json"\n'
    printf 'form-string = "token=%s"\n' "$(curl_config_escape "$PUSHOVER_TOKEN")"
    printf 'form-string = "user=%s"\n' "$(curl_config_escape "$PUSHOVER_USER")"
    printf 'form-string = "message=%s"\n' "$(curl_config_escape "$message")"
  } | curl -K - >/dev/null 2>&1; then
    log_msg "Pushover notification failed"
    return 1
  fi

  return 0
}

# ---- Per-peer variable helpers ---------------------------------------------

# safe_peer_name PEER
#
# Converts a validated peer name into a shell-variable-safe suffix.  The
# validator rejects collisions before this helper is used for state storage.
safe_peer_name() {
  printf '%s' "$1" | sed 's/[^A-Za-z0-9_]/_/g'
}

# peer_var ATTR PEER
#
# Builds the dynamic shell variable name used for one per-peer attribute.
peer_var() {
  attr="$1"
  peer="$2"
  safe="$(safe_peer_name "$peer")"
  printf 'tsw_%s_%s' "$attr" "$safe"
}

# get_peer_attr ATTR PEER DEFAULT
#
# Reads a dynamic per-peer variable, returning DEFAULT when unset or empty.
# Peer names are validated before use so the eval target is controlled.
get_peer_attr() {
  attr="$1"
  peer="$2"
  default="$3"
  var="$(peer_var "$attr" "$peer")"
  eval "_gpa_tmp=\"\${${var}:-}\""
  if [ -z "$_gpa_tmp" ]; then
    printf '%s\n' "$default"
  else
    printf '%s\n' "$_gpa_tmp"
  fi
}

# set_peer_attr ATTR PEER VALUE
#
# Writes a dynamic per-peer variable.  Keep all callers behind config
# validation so ATTR/PEER cannot become arbitrary shell code.
set_peer_attr() {
  attr="$1"
  peer="$2"
  value="$3"
  var="$(peer_var "$attr" "$peer")"
  eval "${var}=\$value"
}

# reset_all_peer_state_after_restart
#
# Resets every peer after a successful restart and clears global deferral
# state.  Restart impact is global, so all peer counters are reset together.
reset_all_peer_state_after_restart() {
  _noglob_was_set=0
  case $- in
    *f*) _noglob_was_set=1 ;;
    *) set -f ;;
  esac
  for peer in $PEERS; do
    set_peer_attr count "$peer" 0
    set_peer_attr state "$peer" post_restart
    set_peer_attr threshold_seen "$peer" none
  done
  if [ "$_noglob_was_set" -eq 0 ]; then
    set +f
  fi
  RESTART_DEFERRAL_ATTEMPTS=0
  unset _noglob_was_set
}

# reset_restart_deferral_if_no_threshold
#
# Clears global deferral attempts when no peer remains at or above the relay
# threshold.  This prevents stale busy-traffic deferrals from affecting a
# later, unrelated relay episode.
reset_restart_deferral_if_no_threshold() {
  _noglob_was_set=0
  case $- in
    *f*) _noglob_was_set=1 ;;
    *) set -f ;;
  esac
  for peer in $PEERS; do
    count="$(get_peer_attr count "$peer" 0)"
    if [ "$count" -ge "$FAIL_THRESHOLD" ]; then
      if [ "$_noglob_was_set" -eq 0 ]; then
        set +f
      fi
      unset _noglob_was_set
      return 0
    fi
  done
  if [ "$_noglob_was_set" -eq 0 ]; then
    set +f
  fi
  unset _noglob_was_set

  if [ "$RESTART_DEFERRAL_ATTEMPTS" -gt 0 ]; then
    log_msg "Restart deferral state reset: no peer remains at the relay threshold"
  fi
  RESTART_DEFERRAL_ATTEMPTS=0
}

# ---- Restart cooldown state ------------------------------------------------

# random_cooldown_seconds
#
# Returns a random integer in [RESTART_COOLDOWN_MIN, RESTART_COOLDOWN_MAX].
# Uses jot(1), which is available on FreeBSD/pfSense.
#
# -w '%d' forces integer output, preventing jot from returning a
# floating-point value on some inputs.
#
# Falls back to RESTART_COOLDOWN_MIN if jot is unavailable or returns
# something that is not a plain positive integer.  This keeps the watchdog
# operational even if jot behaves unexpectedly; the fallback value is
# predictable and safe, just not randomized.
#
# When MIN == MAX the range is degenerate; that case is handled explicitly
# to avoid jot oddities with a zero-width range on some FreeBSD versions.
random_cooldown_seconds() {
  if [ "$RESTART_COOLDOWN_MIN" -eq "$RESTART_COOLDOWN_MAX" ]; then
    printf '%s\n' "$RESTART_COOLDOWN_MIN"
    return
  fi

  if ! command -v jot >/dev/null 2>&1; then
    log_msg "jot not found; falling back to RESTART_COOLDOWN_MIN=${RESTART_COOLDOWN_MIN}"
    printf '%s\n' "$RESTART_COOLDOWN_MIN"
    return
  fi

  value="$(jot -r -w '%d' 1 "$RESTART_COOLDOWN_MIN" "$RESTART_COOLDOWN_MAX" 2>/dev/null)"

  case "$value" in
    ''|*[!0-9]*)
      log_msg "jot returned unexpected value '${value}'; falling back to RESTART_COOLDOWN_MIN=${RESTART_COOLDOWN_MIN}"
      printf '%s\n' "$RESTART_COOLDOWN_MIN"
      ;;
    *)
      printf '%s\n' "$value"
      ;;
  esac
}

# next_restart_epoch NOW
#
# Reads the cooldown state file and returns the epoch timestamp at which
# the next restart attempt is allowed, or 0 if none is recorded.
#
# The file stores a future epoch (now + random cooldown) written at the time
# of the last restart attempt.  Storing the next-allowed time rather than
# the last-attempt time means this function does not need to recompute elapsed
# time or remember which random cooldown was chosen.
#
# NOW must be passed in by the caller so that the future-timestamp comparison
# uses the same reference point as the elapsed calculation in
# cooldown_remaining, avoiding a race if the clock second rolls over between
# two separate date calls.
#
# If the file contains a value more than one maximum cooldown window plus a
# small drift margin past NOW, it is treated as corrupt or the result of a
# large clock jump and is ignored rather than blocking restarts indefinitely.
next_restart_epoch() {
  now="$1"
  if [ ! -r "$NEXT_RESTART_FILE" ]; then
    printf '0\n'
    return
  fi
  value="$(cat "$NEXT_RESTART_FILE" 2>/dev/null)"
  case "$value" in
    ''|*[!0-9]*)
      printf '0\n'
      return
      ;;
  esac
  ceiling=$(( now + RESTART_COOLDOWN_MAX + 60 ))
  if [ "$value" -gt "$ceiling" ]; then
    log_msg "Warning: next_restart_allowed timestamp is implausibly far in the future (${value}); ignoring cooldown state"
    printf '0\n'
  else
    printf '%s\n' "$value"
  fi
}

# cooldown_remaining
#
# Prints the number of seconds until the next restart attempt is allowed, or
# 0 when no valid active cooldown exists.  Handles expired cooldowns and logs
# notable clock skew without blocking restart decisions.
cooldown_remaining() {
  now="$(date '+%s')"
  next="$(next_restart_epoch "$now")"

  if [ "$next" -eq 0 ]; then
    printf '0\n'
    return
  fi

  remaining=$(( next - now ))

  # A non-positive remaining value means the cooldown has expired, or the
  # clock moved forward past the stored next-allowed time (NTP step, VM
  # resume, etc.).  A backward clock step would make remaining larger, which
  # the "implausibly far future" guard in next_restart_epoch handles instead.
  if [ "$remaining" -le 0 ]; then
    if [ "$remaining" -lt -60 ]; then
      log_msg "Warning: clock skew detected (cooldown expired ${remaining} seconds ago); proceeding"
    fi
    printf '0\n'
    return
  fi

  printf '%s\n' "$remaining"
}

# ---- Restart deferral ------------------------------------------------------
#
# The restart impact is global to local Tailscale connectivity, so the first
# deferral implementation samples interface-wide byte counters rather than
# only checking the peer that happened to reach the relay threshold.

# watchdog_sleep SECONDS
#
# Sleeps in a child process and records its PID so signal handling can
# interrupt long main-loop or deferral sleeps promptly.
watchdog_sleep() {
  seconds="$1"
  sleep "$seconds" &
  SLEEP_PID=$!
  wait "$SLEEP_PID"
  rc=$?
  SLEEP_PID=""
  return "$rc"
}

# parse_interface_bytes IFACE
#
# Reads netstat -ibn style output on stdin and prints the total Ibytes+Obytes
# for IFACE.  Returns non-zero when the interface or byte columns are missing.
parse_interface_bytes() {
  iface="$1"

  awk -v iface="$iface" '
    NR == 1 {
      for (i = 1; i <= NF; i++) {
        if ($i == "Ibytes") {
          ibytes = i
        } else if ($i == "Obytes") {
          obytes = i
        }
      }
      next
    }
    $1 == iface {
      if (ibytes == 0 || obytes == 0) {
        exit 2
      }
      if ($ibytes !~ /^[0-9]+$/ || $obytes !~ /^[0-9]+$/) {
        exit 2
      }
      total += $ibytes + $obytes
      found = 1
    }
    END {
      if (!found) {
        exit 1
      }
      printf "%.0f\n", total
    }
  '
}

# get_interface_bytes IFACE
#
# Reads current interface byte counters using FreeBSD netstat and delegates
# parsing to parse_interface_bytes.  A non-zero return means deferral cannot
# safely determine activity.
get_interface_bytes() {
  iface="$1"

  if ! command -v netstat >/dev/null 2>&1; then
    return 1
  fi

  output="$(netstat -ibn -I "$iface" 2>/dev/null)" || return 1
  printf '%s\n' "$output" | parse_interface_bytes "$iface"
}

# should_defer_restart PEER COUNT
#
# Returns 0 when a restart should be deferred because global Tailscale
# interface traffic appears active.  Returns 1 when restart should proceed,
# including disabled deferral, quiet traffic, max attempts, and fail-open
# activity-check errors.  LAST_RESTART_DEFERRAL_* globals describe the result.
should_defer_restart() {
  reason_peer="$1"
  reason_count="$2"
  LAST_RESTART_DEFERRAL_RESULT="disabled"
  LAST_RESTART_DEFERRAL_DELTA=""
  LAST_RESTART_DEFERRAL_ATTEMPTS="$RESTART_DEFERRAL_ATTEMPTS"

  if [ "$RESTART_DEFERRAL_ENABLED" -ne 1 ]; then
    return 1
  fi

  if [ "$RESTART_DEFERRAL_ATTEMPTS" -ge "$RESTART_DEFERRAL_MAX_ATTEMPTS" ]; then
    LAST_RESTART_DEFERRAL_RESULT="max_attempts"
    LAST_RESTART_DEFERRAL_ATTEMPTS="$RESTART_DEFERRAL_ATTEMPTS"
    log_msg "Restart deferral limit reached (${RESTART_DEFERRAL_ATTEMPTS}/${RESTART_DEFERRAL_MAX_ATTEMPTS}); proceeding with restart"
    return 1
  fi

  first="$(get_interface_bytes "$RESTART_DEFERRAL_INTERFACE")"
  if [ "$?" -ne 0 ]; then
    LAST_RESTART_DEFERRAL_RESULT="check_failed"
    log_msg "Restart deferral activity check failed for interface ${RESTART_DEFERRAL_INTERFACE}; proceeding without deferral"
    return 1
  fi

  if ! watchdog_sleep "$RESTART_DEFERRAL_CHECK_SECONDS"; then
    LAST_RESTART_DEFERRAL_RESULT="interrupted"
    log_msg "Restart deferral sleep interrupted; proceeding without deferral"
    return 1
  fi

  second="$(get_interface_bytes "$RESTART_DEFERRAL_INTERFACE")"
  if [ "$?" -ne 0 ]; then
    LAST_RESTART_DEFERRAL_RESULT="check_failed"
    log_msg "Restart deferral activity check failed for interface ${RESTART_DEFERRAL_INTERFACE}; proceeding without deferral"
    return 1
  fi

  delta=$(( second - first ))
  LAST_RESTART_DEFERRAL_DELTA="$delta"
  if [ "$delta" -lt 0 ]; then
    LAST_RESTART_DEFERRAL_RESULT="counter_backward"
    log_msg "Restart deferral activity check failed: byte counter moved backward on ${RESTART_DEFERRAL_INTERFACE}; proceeding without deferral"
    return 1
  fi

  if [ "$delta" -le "$RESTART_DEFERRAL_MAX_BYTES" ]; then
    LAST_RESTART_DEFERRAL_RESULT="quiet"
    if [ "$RESTART_DEFERRAL_ATTEMPTS" -gt 0 ]; then
      log_msg "Restart deferral ended: interface ${RESTART_DEFERRAL_INTERFACE} is quiet (${delta} bytes over ${RESTART_DEFERRAL_CHECK_SECONDS}s)"
    fi
    RESTART_DEFERRAL_ATTEMPTS=0
    LAST_RESTART_DEFERRAL_ATTEMPTS="$RESTART_DEFERRAL_ATTEMPTS"
    return 1
  fi

  RESTART_DEFERRAL_ATTEMPTS=$((RESTART_DEFERRAL_ATTEMPTS + 1))
  LAST_RESTART_DEFERRAL_RESULT="busy"
  LAST_RESTART_DEFERRAL_ATTEMPTS="$RESTART_DEFERRAL_ATTEMPTS"
  log_msg "Restart deferred (${RESTART_DEFERRAL_ATTEMPTS}/${RESTART_DEFERRAL_MAX_ATTEMPTS}): interface ${RESTART_DEFERRAL_INTERFACE} saw ${delta} bytes over ${RESTART_DEFERRAL_CHECK_SECONDS}s after peer ${reason_peer} reached ${reason_count}/${FAIL_THRESHOLD} relayed checks"
  return 0
}

# mark_restart_attempt
#
# Atomically writes the next allowed restart epoch before service restart
# commands run.  This consumes cooldown for both successful and failed restart
# attempts, preventing tight retry loops.  LAST_RESTART_* globals expose the
# selected cooldown for later summary logging.
mark_restart_attempt() {
  tmp_next=""
  LAST_RESTART_COOLDOWN=""
  LAST_RESTART_NEXT_ALLOWED=""

  if [ -L "$STATE_DIR" ]; then
    log_msg "State path is a symlink, refusing to write cooldown state: ${STATE_DIR}"
    return 1
  fi
  if [ -e "$STATE_DIR" ] && [ ! -d "$STATE_DIR" ]; then
    log_msg "State path exists but is not a directory: ${STATE_DIR}"
    return 1
  fi
  if ! mkdir -p "$STATE_DIR" 2>/dev/null; then
    log_msg "Could not create state directory: ${STATE_DIR}"
    return 1
  fi
  chmod 0700 "$STATE_DIR" 2>/dev/null || true

  # Choose a random cooldown and compute the next-allowed timestamp.
  # This is done on every restart attempt — success or failure — so that
  # multiple routers monitoring one another do not synchronize their retry
  # timing even when they all fail to restart at the same time.
  cooldown="$(random_cooldown_seconds)"
  now="$(date '+%s')"
  next=$(( now + cooldown ))

  if [ -e "$NEXT_RESTART_FILE" ] && [ ! -f "$NEXT_RESTART_FILE" ]; then
    log_msg "Restart cooldown state path exists but is not a regular file: ${NEXT_RESTART_FILE}"
    return 1
  fi

  tmp_next="$(mktemp "${STATE_DIR}/.next_restart_allowed.XXXXXX")" || {
    log_msg "Could not create temporary restart cooldown state in: ${STATE_DIR}"
    return 1
  }

  if ! printf '%s\n' "$next" > "$tmp_next" 2>/dev/null; then
    rm -f "$tmp_next"
    log_msg "Could not write restart cooldown state: ${NEXT_RESTART_FILE}"
    return 1
  fi
  chmod 0600 "$tmp_next" 2>/dev/null || true

  if ! mv -f "$tmp_next" "$NEXT_RESTART_FILE" 2>/dev/null; then
    rm -f "$tmp_next"
    log_msg "Could not move restart cooldown state into place: ${NEXT_RESTART_FILE}"
    return 1
  fi

  LAST_RESTART_COOLDOWN="$cooldown"
  LAST_RESTART_NEXT_ALLOWED="$next"
  log_msg "Restart cooldown selected: cooldown=${cooldown}s next_allowed_epoch=${next} range=(min=${RESTART_COOLDOWN_MIN}s,max=${RESTART_COOLDOWN_MAX}s)"
  return 0
}

# ---- Tailscale path classification -----------------------------------------
#
# Classification policy:
#
#   direct:
#     At least one "pong from ... via ..." line exists that is not DERP and
#     not peer-relay.  This handles the common case where initial pongs use
#     DERP and later pongs upgrade to a direct path.
#
#   relayed:
#     One or more pongs used DERP or peer-relay, and no direct pong appeared.
#
#   unknown:
#     No usable pong path was found (timeout, peer offline, parse failure).

# classify_ping_output
#
# Reads tailscale ping output from stdin and prints exactly one classification:
# direct, relayed, or unknown.  Direct wins if mixed output contains any direct
# pong because Tailscale can upgrade from DERP to direct during a ping run.
classify_ping_output() {
  awk '
    /^pong from / && / via / {
      if ($0 ~ / via DERP/ || $0 ~ / via peer-relay/) {
        relayed = 1
      } else {
        direct = 1
      }
    }
    END {
      if (direct) {
        print "direct"
      } else if (relayed) {
        print "relayed"
      } else {
        print "unknown"
      }
    }
  '
}

# check_peer_path PEER
#
# Runs tailscale ping and returns the classification (direct/relayed/unknown)
# on stdout.  All debug output goes to stderr so that the return value on
# stdout is always exactly one word and is safe to capture with $().
check_peer_path() {
  peer="$1"
  output="$(tailscale ping -c "$PING_COUNT" "$peer" 2>&1)"
  rc=$?
  class="$(printf '%s\n' "$output" | classify_ping_output)"
  if [ "$DEBUG" -eq 1 ]; then
    debug_msg "peer=${peer} class=${class} tailscale_ping_rc=${rc}"
    printf '%s\n' "$output" | sed 's/^/  /' >&2
  fi
  printf '%s\n' "$class"
}

# ---- Restart handling ------------------------------------------------------

# restart_tailscale_services PEER COUNT
#
# Marks cooldown, restarts each configured service, sends optional notification,
# and resets all peer state only if every service restart succeeds.  On failure,
# counters are preserved so retry can happen after cooldown.
restart_tailscale_services() {
  reason_peer="$1"
  reason_count="$2"
  failures=0

  log_msg "Restarting Tailscale services after peer ${reason_peer} was relayed for ${reason_count} consecutive checks"

  # Write the next-allowed restart timestamp before attempting the restart.
  # Done regardless of whether the restart succeeds so that a failed restart
  # does not leave multiple routers free to retry in lockstep.
  if ! mark_restart_attempt; then
    log_msg "Restart suppressed: could not write restart cooldown state"
    return 1
  fi

  _noglob_was_set=0
  case $- in
    *f*) _noglob_was_set=1 ;;
    *) set -f ;;
  esac
  for svc in $RESTART_SERVICES; do
    output="$(service "$svc" restart 2>&1)"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      log_msg "Service restarted successfully: ${svc}"
    else
      failures=$((failures + 1))
      log_msg "Service restart FAILED: ${svc}; rc=${rc}; output=${output}"
    fi
  done
  if [ "$_noglob_was_set" -eq 0 ]; then
    set +f
  fi
  unset _noglob_was_set

  if [ "$failures" -eq 0 ]; then
    msg="Tailscale watchdog: restarted ${RESTART_SERVICES} after peer ${reason_peer} was relayed for ${reason_count} consecutive checks."
    log_msg "$msg"
    notify "$msg"
    reset_all_peer_state_after_restart
    return 0
  fi

  msg="Tailscale watchdog: restart FAILED after peer ${reason_peer} was relayed for ${reason_count} consecutive checks."
  log_msg "$msg"
  notify "$msg"
  return 1
}

# maybe_restart_for_peer PEER COUNT
#
# Applies threshold, test-mode, cooldown, and deferral gates for one peer that
# has just been classified relayed.  Emits the compact restart-decision summary
# used for operational troubleshooting.
maybe_restart_for_peer() {
  peer="$1"
  count="$2"
  decision_peer="$peer"
  decision_count="$count"

  if [ "$count" -lt "$FAIL_THRESHOLD" ]; then
    return 0
  fi

  if [ "$TEST" -eq 1 ]; then
    seen="$(get_peer_attr threshold_seen "$peer" none)"
    if [ "$seen" != "test" ]; then
      log_msg "Restart decision: peer=${decision_peer} count=${decision_count}/${FAIL_THRESHOLD} cooldown=not_checked deferral=not_checked action=test would_restart=\"${RESTART_SERVICES}\""
      log_msg "TEST MODE: peer ${peer} reached ${count}/${FAIL_THRESHOLD} relayed checks; would restart ${RESTART_SERVICES}"
      set_peer_attr threshold_seen "$peer" test
    fi
    return 0
  fi

  remaining="$(cooldown_remaining)"
  if [ "$remaining" -gt 0 ]; then
    seen="$(get_peer_attr threshold_seen "$peer" none)"
    if [ "$seen" != "cooldown" ]; then
      log_msg "Restart decision: peer=${decision_peer} count=${decision_count}/${FAIL_THRESHOLD} cooldown=blocked remaining=${remaining}s deferral=not_checked action=suppress"
      log_msg "Peer ${peer} reached ${count}/${FAIL_THRESHOLD} relayed checks, but restart is suppressed by cooldown for ${remaining} more seconds"
      set_peer_attr threshold_seen "$peer" cooldown
    fi
    return 0
  fi

  if should_defer_restart "$decision_peer" "$decision_count"; then
    log_msg "Restart decision: peer=${decision_peer} count=${decision_count}/${FAIL_THRESHOLD} cooldown=allowed deferral=busy attempts=${LAST_RESTART_DEFERRAL_ATTEMPTS}/${RESTART_DEFERRAL_MAX_ATTEMPTS} delta=${LAST_RESTART_DEFERRAL_DELTA} action=defer"
    set_peer_attr threshold_seen "$decision_peer" deferral
    return 0
  fi

  deferral_result="${LAST_RESTART_DEFERRAL_RESULT:-disabled}"
  if restart_tailscale_services "$decision_peer" "$decision_count"; then
    selected="${LAST_RESTART_COOLDOWN:-unknown}"
    next_allowed="${LAST_RESTART_NEXT_ALLOWED:-unknown}"
    log_msg "Restart decision: peer=${decision_peer} count=${decision_count}/${FAIL_THRESHOLD} cooldown=selected selected=${selected}s next_allowed_epoch=${next_allowed} deferral=${deferral_result} action=restart services=\"${RESTART_SERVICES}\" result=success"
    return 0
  fi

  if [ -n "$LAST_RESTART_COOLDOWN" ]; then
    log_msg "Restart decision: peer=${decision_peer} count=${decision_count}/${FAIL_THRESHOLD} cooldown=selected selected=${LAST_RESTART_COOLDOWN}s next_allowed_epoch=${LAST_RESTART_NEXT_ALLOWED} deferral=${deferral_result} action=restart services=\"${RESTART_SERVICES}\" result=failed"
  else
    log_msg "Restart decision: peer=${decision_peer} count=${decision_count}/${FAIL_THRESHOLD} cooldown=write_failed deferral=${deferral_result} action=suppress"
  fi
  return 1
}

# ---- Per-peer state machine ------------------------------------------------

# handle_direct PEER
#
# Handles a direct classification by clearing the peer's relay counter and
# threshold marker, then clearing global deferral state if no threshold remains.
handle_direct() {
  peer="$1"
  count="$(get_peer_attr count "$peer" 0)"
  state="$(get_peer_attr state "$peer" unknown)"

  case "$state" in
    direct)
      ;;
    relayed|post_restart)
      log_msg "Peer ${peer} is direct (was ${state}; relay counter was ${count})"
      ;;
    *)
      log_msg "Peer ${peer} is direct (initial classification; was: ${state})"
      ;;
  esac

  set_peer_attr count "$peer" 0
  set_peer_attr state "$peer" direct
  set_peer_attr threshold_seen "$peer" none
  reset_restart_deferral_if_no_threshold
}

# handle_relayed PEER
#
# Handles a relayed classification by incrementing the peer's consecutive
# relayed count and then evaluating restart eligibility.
handle_relayed() {
  peer="$1"
  count="$(get_peer_attr count "$peer" 0)"
  count=$((count + 1))
  set_peer_attr count "$peer" "$count"
  set_peer_attr state "$peer" relayed
  log_msg "Peer ${peer} is relayed; consecutive relayed checks=${count}/${FAIL_THRESHOLD}"
  maybe_restart_for_peer "$peer" "$count"
}

# handle_unknown PEER
#
# Handles unclassifiable ping output by breaking the consecutive-relay
# sequence.  Unknown is deliberately not evidence for restart.
handle_unknown() {
  peer="$1"
  count="$(get_peer_attr count "$peer" 0)"
  state="$(get_peer_attr state "$peer" unknown)"

  if [ "$count" -gt 0 ]; then
    log_msg "Peer ${peer} path is unknown; breaking relayed sequence and resetting counter from ${count}"
  elif [ "$state" != "unknown" ]; then
    log_msg "Peer ${peer} path is unknown (was ${state})"
  fi

  set_peer_attr count "$peer" 0
  set_peer_attr state "$peer" unknown
  set_peer_attr threshold_seen "$peer" none
  reset_restart_deferral_if_no_threshold
}

# check_peer PEER
#
# Runs one peer through ping classification and dispatches to the state
# transition handler for the resulting class.
check_peer() {
  peer="$1"
  class="$(check_peer_path "$peer")"
  case "$class" in
    direct)
      handle_direct "$peer"
      ;;
    relayed)
      handle_relayed "$peer"
      ;;
    *)
      handle_unknown "$peer"
      ;;
  esac
}

# check_all_peers
#
# Checks every configured peer once.  Globbing is disabled around PEERS word
# splitting so peer names are treated as literal configured tokens.
check_all_peers() {
  _noglob_was_set=0
  case $- in
    *f*) _noglob_was_set=1 ;;
    *) set -f ;;
  esac
  for peer in $PEERS; do
    check_peer "$peer"
  done
  if [ "$_noglob_was_set" -eq 0 ]; then
    set +f
  fi
  unset _noglob_was_set
}

# ---- Signal handling -------------------------------------------------------

# handle_shutdown
#
# Handles TERM/INT by logging shutdown and interrupting any active sleep before
# exiting.  This keeps rc.d stop responsive even during long intervals.
handle_shutdown() {
  log_msg "Daemon stopping"
  if [ -n "$SLEEP_PID" ]; then
    kill "$SLEEP_PID" 2>/dev/null
    SLEEP_PID=""
  fi
  exit 0
}

# main ARGS...
#
# Loads config, applies CLI overrides, validates final settings, installs
# signal handlers, logs startup, and runs either one check cycle or the daemon
# loop.  Kept out of test mode so tests can source functions safely.
main() {
  # ---- Config path pre-scan ------------------------------------------------

  next_is_config=0
  for arg in "$@"; do
    if [ "$next_is_config" -eq 1 ]; then
      CONFIG_FILE="$arg"
      next_is_config=0
      continue
    fi
    case "$arg" in
      -f)
        next_is_config=1
        ;;
      -f*)
        CONFIG_FILE="${arg#-f}"
        ;;
    esac
  done
  unset next_is_config arg

  load_config_file "$CONFIG_FILE"

  # ---- Option parsing ------------------------------------------------------
  OPTIND=1
  while getopts "t1df:i:n:c:h" opt; do
    case "$opt" in
      t)
        TEST=1
        ;;
      1)
        ONE_SHOT=1
        ;;
      d)
        DEBUG=1
        ;;
      f)
        CONFIG_FILE="$OPTARG"
        ;;
      i)
        if ! is_positive_int "$OPTARG"; then
          echo "Invalid interval: $OPTARG" >&2
          usage
          exit 2
        fi
        CHECK_INTERVAL="$OPTARG"
        ;;
      n)
        if ! is_positive_int "$OPTARG"; then
          echo "Invalid threshold: $OPTARG" >&2
          usage
          exit 2
        fi
        FAIL_THRESHOLD="$OPTARG"
        ;;
      c)
        if ! is_positive_int "$OPTARG"; then
          echo "Invalid ping count: $OPTARG" >&2
          usage
          exit 2
        fi
        PING_COUNT="$OPTARG"
        ;;
      h|*)
        usage
        exit 2
        ;;
    esac
  done
  shift $((OPTIND - 1))

  if [ "$#" -ne 0 ]; then
    usage
    exit 2
  fi

  validate_config

  trap handle_shutdown INT TERM

  log_msg "Daemon started: config=${CONFIG_FILE} peers=\"${PEERS}\" interval=${CHECK_INTERVAL}s threshold=${FAIL_THRESHOLD} ping_count=${PING_COUNT} cooldown=(min=${RESTART_COOLDOWN_MIN}s,max=${RESTART_COOLDOWN_MAX}s) restart_deferral_enabled=${RESTART_DEFERRAL_ENABLED} restart_deferral_interface=${RESTART_DEFERRAL_INTERFACE} test=${TEST} docs=${DOCS_URL}"

  if [ "$ONE_SHOT" -eq 1 ]; then
    check_all_peers
    exit 0
  fi

  while :; do
    check_all_peers
    watchdog_sleep "$CHECK_INTERVAL"
  done
}

if [ "${TAILSCALE_WATCHDOG_TESTING:-0}" != "1" ]; then
  main "$@"
fi

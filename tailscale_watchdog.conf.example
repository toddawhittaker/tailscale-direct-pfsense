# /usr/local/etc/tailscale_watchdog.conf
#
# Configuration for /usr/local/sbin/tailscale_watchdogd.
#
# This is a shell-style config file sourced by the daemon at startup.
# Keep it owned by root and private:
#
#   chown root:wheel /usr/local/etc/tailscale_watchdog.conf
#   chmod 0600 /usr/local/etc/tailscale_watchdog.conf

# ---- Pushover notification settings ----------------------------------------

PUSHOVER_TOKEN="" # Add your_pushover_application_token here to enable notifications.
PUSHOVER_USER=""  # Add your_pushover_user_key here to enable notifications.

# ---- Tailscale peers to monitor --------------------------------------------
#
# Space-separated peer names.
#
# Allowed characters in peer names:
#   A-Z a-z 0-9 . _ -
#
# Avoid names that collapse to the same internal state name after sanitization.
# For example, do not include multiple names such as:
#   router-a
#   router.a
#   router_a
#
# because they all collapse internally to the same state name.

PEERS="router1 router2"

# ---- Check behavior ---------------------------------------------------------

# Seconds between watchdog checks.
CHECK_INTERVAL=60

# Number of consecutive relayed classifications required before restart.
FAIL_THRESHOLD=5

# Number of tailscale ping attempts per peer per check.
#
# Using 5 allows Tailscale time to upgrade from initial DERP path discovery
# to a direct path before the watchdog classifies the peer as relayed.
PING_COUNT=5

# ---- Restart behavior -------------------------------------------------------

# Minimum and maximum seconds after a restart attempt before another restart
# attempt is allowed.
#
# After each restart attempt, the watchdog selects a random value in this range.
# This helps prevent multiple routers that monitor one another from restarting
# in synchronized cycles.
#
# Example:
#   RESTART_COOLDOWN_MIN=900
#   RESTART_COOLDOWN_MAX=1800
#
# means the next restart attempt will be allowed 15 to 30 minutes later.
#
# To use a fixed cooldown instead of a randomized cooldown, set both values
# to the same number.

RESTART_COOLDOWN_MIN=900
RESTART_COOLDOWN_MAX=1800

# Restart deferral checks whether the local Tailscale interface appears quiet
# before restarting services. This is interface-wide, not per peer, because a
# local service restart affects all Tailscale traffic on this router.
#
# If activity detection is unavailable or returns unexpected output, the
# watchdog logs the problem and proceeds with the restart decision.
RESTART_DEFERRAL_ENABLED=1
RESTART_DEFERRAL_INTERFACE="tailscale0"
RESTART_DEFERRAL_CHECK_SECONDS=30
RESTART_DEFERRAL_MAX_BYTES=65536
RESTART_DEFERRAL_MAX_ATTEMPTS=10

# Services to restart when the relay threshold is reached.
RESTART_SERVICES="tailscaled pfsense_tailscaled"

# ---- Notification behavior --------------------------------------------------

# Maximum seconds curl may spend attempting a Pushover notification.
CURL_TIMEOUT=10
